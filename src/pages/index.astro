---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import services from "../data/services.json";

const whatsappHref =
    "https://wa.me/529982701550?text=Hola%2C%20quiero%20agendar%20una%20cita";

const values = [
    {
        title: "Limpieza",
        description: "Instalaciones desinfectadas en cada sesión",
    },
    {
        title: "Profesionalismo",
        description: "Terapeutas certificados y en constante formación",
    },
    {
        title: "Comodidad",
        description: "Ambiente cálido, sin prisas y sin fricciones",
    },
    {
        title: "Seguridad",
        description: "Protocolos clínicos basados en evidencia",
    },
];

const careSteps = [
    {
        title: "Evaluación inicial",
        description:
            "Valoramos tu caso a fondo: historial, movilidad y origen del dolor, para entender qué lo está causando.",
    },
    {
        title: "Plan de tratamiento",
        description:
            "Diseñamos un programa personalizado con objetivos claros y un estimado de sesiones para tu recuperación.",
    },
    {
        title: "Seguimiento terapéutico",
        description:
            "Sesión a sesión ajustamos el tratamiento según tu evolución, siempre con el mismo terapeuta acompañándote.",
    },
    {
        title: "Alta médica",
        description:
            "Evaluamos tu recuperación y te compartimos indicaciones para mantener resultados y prevenir recaídas.",
    },
];

const testimonials = [
    {
        quote: "Después de mi cirugía de rodilla llegué con miedo a moverme. El seguimiento fue muy cuidadoso y hoy camino sin dolor.",
        name: "Roberto C.",
    },
    {
        quote: "La atención es cercana y profesional. Se nota que conocen bien cada caso y explican todo con claridad.",
        name: "Adriana M.",
    },
    {
        quote: "Un espacio limpio y tranquilo, justo lo que necesitaba para mi recuperación deportiva.",
        name: "Fernando L.",
    },
    {
        quote: "Llevo años con dolor de cuello por el trabajo de oficina y en pocas sesiones noté una mejora real. Siempre me explican qué estamos trabajando y por qué.",
        name: "Patricia G.",
    },
    {
        quote: "El trato humano hace toda la diferencia. Me sentí escuchado desde la primera consulta y el plan se fue ajustando a mi ritmo.",
        name: "Jorge N.",
    },
    {
        quote: "Vine buscando ayuda para una lesión de hombro que arrastraba desde hace meses. Hoy entreno de nuevo sin molestias.",
        name: "Daniela R.",
    },
];

const faqs = [
    {
        question: "¿Necesito una referencia médica para agendar cita?",
        answer: "No es obligatorio. Puedes agendar directamente y en la primera consulta evaluamos tu caso; si ya tienes estudios o indicaciones de tu médico, son bienvenidos.",
    },
    {
        question: "¿Cuánto dura una sesión de terapia?",
        answer: "En promedio cada sesión dura entre 45 y 60 minutos, dependiendo del tratamiento y la etapa de tu recuperación.",
    },
    {
        question: "¿Cuántas sesiones necesito?",
        answer: "Varía según cada caso. Al finalizar tu evaluación inicial te compartimos un plan de tratamiento con el número estimado de sesiones.",
    },
    {
        question: "¿Atienden lesiones deportivas y casos postoperatorios?",
        answer: "Sí, contamos con protocolos específicos tanto para deportistas como para pacientes en recuperación después de una cirugía.",
    },
    {
        question: "¿Cómo agendo mi primera cita?",
        answer: "La forma más rápida es por WhatsApp al +52 998 270 1550. También puedes escribirnos a info@goldtherapy.com.",
    },
];
---

<BaseLayout
    title="Fisioterapia y Rehabilitación Física en Cancún | Gold Therapy"
>
    <Header />

    <main>
        <!-- Hero -->
        <section class="py-10">
            <div
                class="container-page flex flex-col relative py-12 overflow-x-hidden sm:py-20 md:flex-row md:bg-[url('/hero-homepage.webp')] md:bg-contain md:bg-right md:bg-no-repeat"
            >
                <div class="relative z-20 md:w-1/2" data-hero-copy>
                    <h1 class="sm:text-5xl">
                        Fisioterapia y Rehabilitación Física en <span
                            class="text-primary">Cancún</span
                        >
                    </h1>
                    <p
                        class="mt-6 text-xl leading-relaxed text-on-surface-variant"
                    >
                        Tratamientos personalizados en un espacio limpio y
                        profesional, pensado para tu comodidad y tu
                        recuperación.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-4">
                        <a
                            href={whatsappHref}
                            class="rounded-md flex gap-1 items-center mt-10 bg-primary px-5 py-3 font-bold uppercase tracking-wide text-on-primary transition-all hover:bg-primary-strong hover:translate-y-[-2px] hover:shadow-lg"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="20"
                                height="20"
                                ><path
                                    fill="#ffffff"
                                    d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23c-1.48 0-2.93-.39-4.19-1.15l-.3-.17l-3.12.82l.83-3.04l-.2-.32a8.2 8.2 0 0 1-1.26-4.38c.01-4.54 3.7-8.24 8.25-8.24M8.53 7.33c-.16 0-.43.06-.66.31c-.22.25-.87.86-.87 2.07c0 1.22.89 2.39 1 2.56c.14.17 1.76 2.67 4.25 3.73c.59.27 1.05.42 1.41.53c.59.19 1.13.16 1.56.1c.48-.07 1.46-.6 1.67-1.18s.21-1.07.15-1.18c-.07-.1-.23-.16-.48-.27c-.25-.14-1.47-.74-1.69-.82c-.23-.08-.37-.12-.56.12c-.16.25-.64.81-.78.97c-.15.17-.29.19-.53.07c-.26-.13-1.06-.39-2-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.12-.24-.01-.39.11-.5c.11-.11.27-.29.37-.44c.13-.14.17-.25.25-.41c.08-.17.04-.31-.02-.43c-.06-.11-.56-1.35-.77-1.84c-.2-.48-.4-.42-.56-.43c-.14 0-.3-.01-.47-.01"
                                ></path></svg
                            >
                            Agendar por WhatsApp
                        </a>
                    </div>
                </div>

                <img
                    src="/hero-homepage.webp"
                    alt="Sesión de fisioterapia en Gold Therapy"
                    class="absolute bottom-0 z-10 w-full md:hidden"
                />
            </div>
        </section>

        <!-- Servicios -->
        <section id="servicios" class="section-y">
            <div class="container-page">
                <h2 data-reveal class="text-center text-[32px]">
                    Servicios de Fisioterapia en Cancún
                </h2>
                <p
                    class="mx-auto mt-4 max-w-160 text-center text-lg leading-relaxed text-on-surface-variant"
                >
                    Un plan de tratamiento distinto para cada necesidad, con
                    técnicas basadas en evidencia y seguimiento cercano en cada
                    sesión.
                </p>

                <div class="mt-14 flex flex-col">
                    {
                        services.map((service, index) => (
                            <article
                                class:list={[
                                    "group flex flex-col py-8 transition-all sm:flex-row",
                                    index !== services.length - 1 &&
                                        "border-b border-gray-200",
                                ]}
                            >
                                <div class="overflow-hidden sm:w-2/5 [mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_75%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_75%)]">
                                    <img
                                        src={service.image}
                                        alt={service.title}
                                        class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-105 sm:h-full"
                                    />
                                </div>
                                <div class="flex flex-1 flex-col justify-center p-8">
                                    <h3 class="text-xl !text-primary text-center md:text-left">
                                        <a
                                            href={service.link}
                                            class="hover:underline"
                                        >
                                            {service.title}
                                        </a>
                                    </h3>
                                    <p class="mt-3 leading-relaxed text-on-surface-variant text-center md:text-left">
                                        {service.description}
                                    </p>
                                    <a
                                        href={service.link}
                                        class="mt-5 flex w-fit mx-auto md:mx-0 items-center gap-1 font-bold text-secondary transition-all hover:gap-2"
                                    >
                                        Saber más
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 24 24"
                                            width="18"
                                            height="18"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M5 12h14" />
                                            <path d="m12 5 7 7-7 7" />
                                        </svg>
                                    </a>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Sobre nosotros / Equipo -->
        <section id="nosotros" class="section-y bg-surface-container-low">
            <div
                class="container-page grid gap-16 lg:grid-cols-[1fr_2fr] lg:items-center"
            >
                <div class="relative">
                    <div class="aspect-3/4 overflow-hidden rounded-lg">
                        <img
                            src="/the-doctor.webp"
                            alt="Lic. Mariana Echeverría"
                            class="h-full w-full object-cover"
                        />
                    </div>
                    <div
                        class="card absolute bottom-0 left-1/2 w-11/12 -translate-x-1/2 translate-y-1/2 p-4"
                    >
                        <p class="text-base font-bold">
                            Lic. Mariana Echeverría
                        </p>
                        <p class="mt-1 text-[12.5px] text-on-surface-variant">
                            Fisioterapeuta especialista en rehabilitación
                            postoperatoria y terapia deportiva.
                        </p>
                    </div>
                </div>

                <div>
                    <h2 data-reveal class="mt-3 text-[32px]">
                        Un espacio pensado para tu recuperación
                    </h2>
                    <p
                        class="mt-5 text-lg leading-relaxed text-on-surface-variant"
                    >
                        Combinamos experiencia clínica y un trato cercano para
                        acompañarte en cada etapa de tu recuperación, con
                        protocolos claros y un ambiente pensado para tu
                        tranquilidad.
                    </p>

                    <div class="mt-10 grid gap-8 sm:grid-cols-2">
                        {
                            values.map((value) => (
                                <div class="flex gap-3">
                                    <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-secondary" />
                                    <div>
                                        <p class="font-bold">{value.title}</p>
                                        <p class="mt-1 text-on-surface-variant">
                                            {value.description}
                                        </p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Proceso de atención -->
        <section id="proceso" class="section-y">
            <div class="container-page">
                <h2 data-reveal class="text-center text-[32px]">
                    Cómo trabajamos contigo
                </h2>
                <p
                    class="mx-auto mt-4 max-w-160 text-center text-lg leading-relaxed text-on-surface-variant"
                >
                    Desde tu primer mensaje hasta tu alta médica, te acompañamos
                    con un proceso claro en cada etapa de tu recuperación.
                </p>

                <div class="relative mt-16">
                    <div
                        class="absolute left-5 top-6 bottom-6 w-0.5 bg-secondary/25 lg:left-0 lg:right-0 lg:top-6 lg:bottom-auto lg:h-0.5 lg:w-auto"
                    >
                    </div>
                    <div class="relative grid gap-10 lg:grid-cols-4 lg:gap-6">
                        {
                            careSteps.map((step, index) => (
                                <div class="relative flex items-start gap-5 lg:flex-col lg:items-center lg:gap-0 lg:text-center">
                                    <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary font-bold text-white">
                                        {index + 1}
                                    </span>
                                    <div class="lg:mt-5">
                                        <h3 class="!text-xl !text-primary">
                                            {step.title}
                                        </h3>
                                        <p class="mt-2 text-base leading-relaxed text-on-surface-variant">
                                            {step.description}
                                        </p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Testimonios -->
        <section id="testimonios" class="section-y">
            <div class="container-page">
                <h2 data-reveal class="text-center text-[32px]">
                    Lo que dicen nuestros pacientes
                </h2>

                <div
                    data-carousel
                    class="relative mt-14 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]"
                >
                    <div data-carousel-track class="flex w-max gap-5">
                        {
                            [...testimonials, ...testimonials].map(
                                (testimonial) => (
                                    <article class="card w-64 shrink-0 p-5 sm:w-72 md:w-90">
                                        <p class="font-serif text-3xl leading-none text-primary">
                                            “
                                        </p>
                                        <p class="mt-2 leading-relaxed text-on-surface-variant">
                                            {testimonial.quote}
                                        </p>
                                        <p class="mt-5 text-lg font-bold">
                                            {testimonial.name}
                                        </p>
                                    </article>
                                ),
                            )
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section id="faq" class="section-y bg-surface-container-low">
            <div class="mx-auto max-w-190 px-7">
                <p
                    class="text-center text-sm font-bold uppercase tracking-widest text-primary-strong"
                >
                    Preguntas frecuentes
                </p>
                <h2 data-reveal class="mt-3 text-center text-[32px]">
                    Resolvemos tus dudas
                </h2>

                <div data-faq-list class="mt-12">
                    {
                        faqs.map((faq, index) => (
                            <article
                                class="border-b"
                                style="border-color: var(--color-outline);"
                            >
                                <button
                                    data-faq-trigger
                                    class="flex w-full cursor-pointer items-center justify-between gap-4 py-6 text-left"
                                    aria-expanded={
                                        index === 0 ? "true" : "false"
                                    }
                                >
                                    <h3 class="text-lg">{faq.question}</h3>
                                    <span
                                        data-faq-icon
                                        class="shrink-0 text-2xl font-bold text-primary-strong"
                                    >
                                        {index === 0 ? "–" : "+"}
                                    </span>
                                </button>
                                <div
                                    data-faq-answer
                                    class={
                                        index === 0
                                            ? "overflow-hidden"
                                            : "hidden overflow-hidden"
                                    }
                                >
                                    <p class="pb-6 leading-relaxed text-on-surface-variant">
                                        {faq.answer}
                                    </p>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            gsap.registerPlugin(ScrollTrigger);

            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            if (!reduceMotion) {
                // Entrada del hero: el título, el texto y el CTA aparecen en
                // cascada para dar una primera impresión con más cuidado que
                // un renderizado estático.
                const heroCopy =
                    document.querySelector<HTMLElement>("[data-hero-copy]");

                if (heroCopy) {
                    gsap.from(heroCopy.querySelectorAll(":scope > *"), {
                        opacity: 0, // arrancan invisibles
                        y: 20, // y se asientan 20px hacia arriba
                        duration: 0.7,
                        stagger: 0.12, // cada elemento aparece un poco después del anterior
                        ease: "power2.out",
                    });
                }

                // Los títulos de cada sección se revelan al entrar en
                // pantalla, marcando la jerarquía de contenido conforme se
                // hace scroll en vez de mostrar todo de golpe.
                gsap.utils
                    .toArray<HTMLElement>("[data-reveal]")
                    .forEach((heading) => {
                        gsap.from(heading, {
                            opacity: 0,
                            y: 24,
                            duration: 0.7,
                            ease: "power2.out",
                            scrollTrigger: {
                                trigger: heading,
                                start: "top 85%",
                            },
                        });
                    });
            }

            const carousel =
                document.querySelector<HTMLDivElement>("[data-carousel]");
            const track = document.querySelector<HTMLDivElement>(
                "[data-carousel-track]",
            );

            if (carousel && track) {
                // La pista se duplicó en el markup, así que la mitad de su
                // ancho es un ciclo completo del carrusel.
                const cycleDistance = track.scrollWidth / 2;

                const marquee = gsap.to(track, {
                    x: -cycleDistance, // desplaza la pista un ciclo completo hacia la izquierda
                    duration: cycleDistance / 40, // velocidad constante (~40px/s)
                    ease: "none", // movimiento lineal, sin aceleración
                    repeat: -1, // se repite infinitamente
                });

                carousel.addEventListener("mouseenter", () => marquee.pause());
                carousel.addEventListener("mouseleave", () => marquee.play());
            }

            const triggers =
                document.querySelectorAll<HTMLButtonElement>(
                    "[data-faq-trigger]",
                );

            triggers.forEach((trigger) => {
                trigger.addEventListener("click", () => {
                    const isOpen =
                        trigger.getAttribute("aria-expanded") === "true";

                    triggers.forEach((item) => {
                        item.setAttribute("aria-expanded", "false");
                        const answer = item.nextElementSibling as HTMLElement;
                        const icon = item.querySelector(
                            "[data-faq-icon]",
                        ) as HTMLElement;
                        answer.classList.add("hidden");
                        icon.textContent = "+";
                    });

                    if (!isOpen) {
                        trigger.setAttribute("aria-expanded", "true");
                        const answer =
                            trigger.nextElementSibling as HTMLElement;
                        const icon = trigger.querySelector(
                            "[data-faq-icon]",
                        ) as HTMLElement;
                        answer.classList.remove("hidden");
                        icon.textContent = "–";
                    }
                });
            });
        </script>
    </main>

    <Footer />
</BaseLayout>
