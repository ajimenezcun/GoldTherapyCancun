---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import ServicesCarousel from "../components/sections/ServicesCarousel.astro";
import ReviewsCarrousel from "../components/sections/ReviewsCarrousel.astro";
---

<BaseLayout title="Fisioterapia a Domicilio en Cancún | Gold Therapy">
    <Header variant="home" />

    <main class="home-main overflow-hidden">
        <section class="relative min-h-screen flex items-center pt-12">
            <div class="absolute inset-0">
                <img
                    alt="Sesion de fisioterapia"
                    class="h-full w-full object-cover"
                    src="/gold-therapy-hero.webp"
                />
            </div>
            <div
                class="absolute inset-0 bg-[linear-gradient(112deg,rgba(0,27,55,0.9)_6%,rgba(0,51,102,0.74)_50%,rgba(0,51,102,0.18)_100%)]"
            >
            </div>
            <div
                class="absolute -top-16 -left-28 h-80 w-80 rounded-full bg-primary/25 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-20 right-0 h-72 w-72 rounded-full bg-secondary/35 blur-3xl"
            >
            </div>

            <div
                class="relative z-10 mx-auto grid w-full max-w-7xl gap-14 px-6 py-28 lg:grid-cols-2 lg:items-center"
            >
                <div class="space-y-8">
                    <h1 class="home-fade text-primary! [animation-delay:120ms]">
                        Recupera tu movilidad sin salir de casa
                    </h1>
                    <p
                        class="home-fade max-w-xl text-lg leading-relaxed text-slate-100 [animation-delay:220ms] md:text-xl"
                    >
                        Terapia fisica a domicilio con evaluacion clinica,
                        tratamiento personalizado y seguimiento profesional para
                        aliviar dolor y volver a tu ritmo de vida.
                    </p>
                    <div
                        class="home-fade flex flex-wrap gap-4 [animation-delay:320ms]"
                    >
                        <a
                            href="/contacto"
                            class="rounded-full bg-primary px-8 py-3.5 text-lg font-extrabold text-on-primary shadow-[0_18px_35px_rgba(228,206,131,0.35)] transition-transform hover:-translate-y-1"
                        >
                            Agenda una consulta
                        </a>
                        <a
                            href="/servicios"
                            class="rounded-full border border-white/55 bg-white/10 px-8 py-3.5 text-lg font-bold text-white transition-colors hover:bg-white/22"
                        >
                            Explorar servicios
                        </a>
                    </div>
                </div>

                <div class="home-fade [animation-delay:420ms]">
                    <div
                        class="rounded-3xl border border-secondary/15 bg-white p-4 shadow-[0_22px_50px_rgba(0,35,89,0.25)] md:p-5"
                    >
                        <div class="grid gap-4 sm:grid-cols-2">
                            <article
                                class="rounded-2xl border border-secondary/10 bg-surface p-6"
                            >
                                <p class="text-5xl font-black text-secondary">
                                    <span
                                        data-count-number="98"
                                        data-count-suffix="%">0%</span
                                    >
                                </p>
                                <p
                                    class="mt-3 text-sm font-bold uppercase tracking-[0.12em] text-secondary/80"
                                >
                                    Mejora funcional
                                </p>
                                <p class="mt-1 text-sm text-on-surface-variant">
                                    en dolor cronico
                                </p>
                            </article>
                            <article
                                class="rounded-2xl border border-secondary/10 bg-surface p-6"
                            >
                                <p class="text-5xl font-black text-secondary">
                                    <span
                                        data-count-number="100"
                                        data-count-suffix="+">0+</span
                                    >
                                </p>
                                <p
                                    class="mt-3 text-sm font-bold uppercase tracking-[0.12em] text-secondary/80"
                                >
                                    Pacientes
                                </p>
                                <p class="mt-1 text-sm text-on-surface-variant">
                                    recuperados en Cancun
                                </p>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative bg-surface py-24">
            <div
                class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[1.1fr_1fr] lg:items-center"
            >
                <div class="space-y-6">
                    <p
                        class="text-sm font-bold uppercase tracking-[0.22em] text-secondary/70"
                    >
                        Bienvenido a Gold Therapy
                    </p>
                    <h2>Un tratamiento adaptado a tu ritmo de vida</h2>
                    <p class="text-lg leading-relaxed text-on-surface-variant">
                        Combinamos experiencia clinica, tecnologia y trato
                        humano para que cada sesion tenga objetivos claros,
                        avance medible y una experiencia comoda en tu espacio.
                    </p>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <article
                        class="rounded-2xl border border-secondary/15 bg-white p-6 shadow-[0_20px_40px_rgba(0,48,102,0.08)]"
                    >
                        <p class="text-3xl font-black text-secondary">45 min</p>
                        <p class="mt-2 font-semibold text-on-surface-variant">
                            Sesiones enfocadas y efectivas
                        </p>
                    </article>
                    <article
                        class="rounded-2xl border border-secondary/15 bg-white p-6 shadow-[0_20px_40px_rgba(0,48,102,0.08)]"
                    >
                        <p class="text-3xl font-black text-secondary">24 hrs</p>
                        <p class="mt-2 font-semibold text-on-surface-variant">
                            Tiempo promedio de respuesta
                        </p>
                    </article>
                    <article
                        class="rounded-2xl border border-primary/40 bg-primary/15 p-6 sm:col-span-2"
                    >
                        <p
                            class="font-black uppercase tracking-[0.14em] text-secondary"
                        >
                            Cobertura en zona urbana de Cancun
                        </p>
                        <p class="mt-2 text-on-surface-variant">
                            Atencion domiciliaria para procesos ortopedicos,
                            neurologicos y post operatorios.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="relative bg-surface-container-low py-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mb-14 text-center">
                    <h2>Servicios de terapia fisica en Cancun</h2>
                    <p
                        class="mx-auto mt-4 max-w-2xl text-lg text-on-surface-variant"
                    >
                        Tratamientos especializados para restaurar movilidad,
                        reducir dolor y fortalecer tu recuperacion.
                    </p>
                </div>
                <ServicesCarousel />
            </div>
        </section>

        <section class="bg-white py-24">
            <div
                class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-2 lg:items-center"
            >
                <div class="relative overflow-hidden rounded-3xl">
                    <img
                        alt="Sesion de fisioterapia en casa"
                        class="h-full w-full object-cover"
                        src="/why.jpg"
                    />
                    <div
                        class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,51,102,0)_35%,rgba(0,51,102,0.65)_100%)]"
                    >
                    </div>
                    <p
                        class="absolute bottom-6 left-6 rounded-full bg-white/20 px-4 py-2 text-sm font-bold uppercase tracking-[0.15em] text-white backdrop-blur"
                    >
                        Atencion personalizada
                    </p>
                </div>

                <div class="space-y-8">
                    <h2>¿Por qué fisioterapia a domicilio?</h2>
                    <p class="text-lg leading-relaxed text-on-surface-variant">
                        Recibe tratamiento en un entorno familiar que facilita
                        adherencia, reduce traslados y mejora la continuidad del
                        proceso de recuperación.
                    </p>
                    <ul class="space-y-4 text-on-surface">
                        <li class="home-check-item">
                            Evaluación y seguimiento continuo.
                        </li>
                        <li class="home-check-item">
                            écnicas manuales y ejercicio terapéutico.
                        </li>
                        <li class="home-check-item">
                            Plan adaptado a tus objetivos reales.
                        </li>
                    </ul>
                    <a
                        href="/contacto"
                        class="inline-flex rounded-full bg-secondary px-8 py-3.5 text-lg font-bold text-white transition-colors hover:bg-primary-container"
                    >
                        Agendar una consulta
                    </a>
                </div>
            </div>
        </section>

        <section class="bg-surface-container-low py-24">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mb-14 max-w-xl">
                    <h2>Historias de pacientes</h2>
                    <p class="mt-4 text-lg text-on-surface-variant">
                        Experiencias reales de recuperacion y mejora funcional.
                    </p>
                </div>

                <ReviewsCarrousel />
            </div>
        </section>

        <section class="bg-white py-24">
            <div
                class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[0.42fr_1fr]"
            >
                <div>
                    <h2>Preguntas frecuentes</h2>
                    <p class="mt-4 text-lg text-on-surface-variant">
                        Respuestas rapidas sobre la terapia fisica a domicilio.
                    </p>
                    <a
                        href="/contacto"
                        class="mt-7 inline-flex rounded-full bg-primary px-7 py-3.5 text-base font-extrabold text-on-primary transition-transform hover:-translate-y-1"
                    >
                        Agendar una consulta
                    </a>
                </div>

                <div
                    data-faq-list
                    class="rounded-3xl border border-secondary/10 bg-surface-container-low px-6 py-3 md:px-10"
                >
                    <article class="border-b border-secondary/15">
                        <button
                            data-faq-trigger
                            class="w-full cursor-pointer py-6 text-left"
                            aria-expanded="false"
                        >
                            <span
                                class="flex items-center justify-between gap-4"
                            >
                                <h3 class="text-xl font-bold text-secondary">
                                    Que tratamientos ofrecen a domicilio
                                </h3>
                                <span
                                    data-faq-icon
                                    class="text-primary text-2xl font-light"
                                    >+</span
                                >
                            </span>
                        </button>
                        <div data-faq-answer class="hidden overflow-hidden">
                            <p
                                class="pb-6 text-lg leading-relaxed text-on-surface-variant"
                            >
                                Terapia manual, ejercicio terapeutico,
                                rehabilitacion post operatoria y programas
                                personalizados para dolor y movilidad.
                            </p>
                        </div>
                    </article>

                    <article class="border-b border-secondary/15">
                        <button
                            data-faq-trigger
                            class="w-full cursor-pointer py-6 text-left"
                            aria-expanded="false"
                        >
                            <span
                                class="flex items-center justify-between gap-4"
                            >
                                <h3 class="text-xl font-bold text-secondary">
                                    Como personalizan cada sesion
                                </h3>
                                <span
                                    data-faq-icon
                                    class="text-primary text-2xl font-light"
                                    >+</span
                                >
                            </span>
                        </button>
                        <div data-faq-answer class="hidden overflow-hidden">
                            <p
                                class="pb-6 text-lg leading-relaxed text-on-surface-variant"
                            >
                                Iniciamos con una evaluacion completa y
                                definimos metas funcionales para ajustar el plan
                                en cada visita.
                            </p>
                        </div>
                    </article>

                    <article class="border-b border-secondary/15">
                        <button
                            data-faq-trigger
                            class="w-full cursor-pointer py-6 text-left"
                            aria-expanded="false"
                        >
                            <span
                                class="flex items-center justify-between gap-4"
                            >
                                <h3 class="text-xl font-bold text-secondary">
                                    Que zonas de Cancun cubren
                                </h3>
                                <span
                                    data-faq-icon
                                    class="text-primary text-2xl font-light"
                                    >+</span
                                >
                            </span>
                        </button>
                        <div data-faq-answer class="hidden overflow-hidden">
                            <p
                                class="pb-6 text-lg leading-relaxed text-on-surface-variant"
                            >
                                Cubrimos la mayoria de zonas urbanas y
                                residenciales de Cancun.
                            </p>
                        </div>
                    </article>

                    <article class="border-b border-secondary/15">
                        <button
                            data-faq-trigger
                            class="w-full cursor-pointer py-6 text-left"
                            aria-expanded="false"
                        >
                            <span
                                class="flex items-center justify-between gap-4"
                            >
                                <h3 class="text-xl font-bold text-secondary">
                                    Como puedo agendar mi consulta
                                </h3>
                                <span
                                    data-faq-icon
                                    class="text-primary text-2xl font-light"
                                    >+</span
                                >
                            </span>
                        </button>
                        <div data-faq-answer class="hidden overflow-hidden">
                            <p
                                class="pb-6 text-lg leading-relaxed text-on-surface-variant"
                            >
                                Desde el formulario de contacto o por WhatsApp.
                                Te ayudamos a definir horario y objetivos.
                            </p>
                        </div>
                    </article>

                    <article>
                        <button
                            data-faq-trigger
                            class="w-full cursor-pointer py-6 text-left"
                            aria-expanded="false"
                        >
                            <span
                                class="flex items-center justify-between gap-4"
                            >
                                <h3 class="text-xl font-bold text-secondary">
                                    Que medidas de higiene utilizan
                                </h3>
                                <span
                                    data-faq-icon
                                    class="text-primary text-2xl font-light"
                                    >+</span
                                >
                            </span>
                        </button>
                        <div data-faq-answer class="hidden overflow-hidden">
                            <p
                                class="pb-6 text-lg leading-relaxed text-on-surface-variant"
                            >
                                Equipo desinfectado en cada visita y protocolos
                                estrictos de higiene en todo el proceso.
                            </p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <script>
            const counters = document.querySelectorAll<HTMLElement>(
                "[data-count-number]",
            );

            const animateCounter = (element: HTMLElement) => {
                const target = Number(element.dataset.countNumber ?? "0");
                const suffix = element.dataset.countSuffix ?? "";
                const duration = 1200;
                const start = performance.now();

                const render = (now: number) => {
                    const progress = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const value = Math.floor(target * eased);

                    element.textContent = `${value}${suffix}`;

                    if (progress < 1) {
                        requestAnimationFrame(render);
                    }
                };

                requestAnimationFrame(render);
            };

            if (counters.length > 0) {
                const observer = new IntersectionObserver(
                    (entries, obs) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;

                            animateCounter(entry.target as HTMLElement);
                            obs.unobserve(entry.target);
                        });
                    },
                    {
                        threshold: 0.6,
                    },
                );

                counters.forEach((counter) => observer.observe(counter));
            }

            const triggers =
                document.querySelectorAll<HTMLButtonElement>(
                    "[data-faq-trigger]",
                );

            triggers.forEach((trigger) => {
                trigger.addEventListener("click", () => {
                    const isOpen =
                        trigger.getAttribute("aria-expanded") === "true";

                    triggers.forEach((item) => {
                        item.setAttribute("aria-expanded", "false");
                        const answer = item.nextElementSibling as HTMLElement;
                        const icon = item.querySelector(
                            "[data-faq-icon]",
                        ) as HTMLElement;
                        answer.classList.add("hidden");
                        icon.textContent = "+";
                        icon.style.transform = "rotate(0deg)";
                    });

                    if (!isOpen) {
                        trigger.setAttribute("aria-expanded", "true");
                        const answer =
                            trigger.nextElementSibling as HTMLElement;
                        const icon = trigger.querySelector(
                            "[data-faq-icon]",
                        ) as HTMLElement;
                        answer.classList.remove("hidden");
                        icon.textContent = "x";
                        icon.style.transform = "rotate(180deg)";
                    }
                });
            });
        </script>
    </main>

    <Footer variant="home" />

    <style>
        .home-main {
            background:
                radial-gradient(
                    circle at 8% 14%,
                    rgba(228, 206, 131, 0.22),
                    transparent 34%
                ),
                radial-gradient(
                    circle at 92% 28%,
                    rgba(30, 95, 171, 0.14),
                    transparent 32%
                ),
                linear-gradient(180deg, #f7f8fb 0%, #f5f5f5 22%, #f5f5f5 100%);
        }

        .home-check-item {
            position: relative;
            padding-left: 2rem;
            font-weight: 700;
        }

        .home-check-item::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0.38rem;
            width: 1.1rem;
            height: 1.1rem;
            border-radius: 999px;
            background: linear-gradient(135deg, #e4ce83 0%, #d8b95c 100%);
            box-shadow: 0 0 0 4px rgba(228, 206, 131, 0.25);
        }

        .home-fade {
            animation: homeFade 700ms cubic-bezier(0.19, 1, 0.22, 1) both;
        }

        @keyframes homeFade {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</BaseLayout>
