---
interface Props {
    variant?: "default" | "home";
}

const { variant = "default" } = Astro.props;

const isHome = variant === "home";

const headerClass = isHome
    ? "absolute inset-x-0 top-0 z-50 w-full px-3 pt-3 md:px-6 md:pt-4 transition-all duration-500"
    : "sticky top-0 w-full z-50 bg-white/80 backdrop-blur-xl shadow-[0_10px_40px_rgba(0,30,64,0.06)]";

const innerClass = isHome
    ? "flex justify-between items-center w-full px-6 lg:px-8 py-3 max-w-7xl mx-auto rounded-2xl border border-white/55 bg-[linear-gradient(180deg,rgba(255,255,255,0.95)_0%,rgba(255,255,255,0.88)_100%)] shadow-[0_16px_35px_rgba(0,35,89,0.15)] backdrop-blur-xl"
    : "flex justify-between items-center w-full px-6 lg:px-8 py-3 max-w-7xl mx-auto";

const navClass = isHome
    ? "hidden md:flex items-center space-x-7 *:uppercase *:font-serif *:text-sm"
    : "hidden md:flex items-center space-x-7 *:uppercase *:font-serif *:text-sm";
---

<header class={headerClass}>
    <div class={innerClass} data-home-shell={isHome ? "true" : undefined}>
        <div class="text-xl font-bold tracking-tight text-primary-container">
            <a href="/"
                ><img
                    src="/GoldTherapy.webp"
                    alt="Gold Therapy"
                    class="w-20"
                /></a
            >
        </div>

        <nav class={navClass}>
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/sobre-mi">Sobre Mi</a
            >
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/servicios">Servicios</a
            >
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/a-domicilio">a Domicilio</a
            >
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/contacto">Contacto</a
            >
        </nav>

        <div class="flex items-center space-x-6">
            <a
                class="hidden lg:block font-bold text-primary-strong text-lg"
                href="tel:+525500000000"
            >
                +52 998 270 1550
            </a>
            <a
                href="https://wa.me/525500000000"
                class="hidden lg:flex items-center gap-2 rounded-full bg-secondary text-white px-5 py-2.5 font-bold shadow-[0_10px_24px_rgba(0,62,133,0.35)] hover:bg-primary-container transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 16 16"
                    ><path
                        fill="#ffffff"
                        d="M13.95 4.24C11.86 1 7.58.04 4.27 2.05C1.04 4.06 0 8.44 2.09 11.67l.17.26l-.7 2.62l2.62-.7l.26.17c1.13.61 2.36.96 3.58.96c1.31 0 2.62-.35 3.75-1.05c3.23-2.1 4.19-6.39 2.18-9.71Zm-1.83 6.74c-.35.52-.79.87-1.4.96c-.35 0-.79.17-2.53-.52c-1.48-.7-2.71-1.84-3.58-3.15c-.52-.61-.79-1.4-.87-2.19c0-.7.26-1.31.7-1.75c.17-.17.35-.26.52-.26h.44c.17 0 .35 0 .44.35c.17.44.61 1.49.61 1.58c.09.09.05.76-.35 1.14c-.22.25-.26.26-.17.44c.35.52.79 1.05 1.22 1.49c.52.44 1.05.79 1.66 1.05c.17.09.35.09.44-.09c.09-.17.52-.61.7-.79c.17-.17.26-.17.44-.09l1.4.7c.17.09.35.17.44.26c.09.26.09.61-.09.87Z"
                    ></path></svg
                >
                AGENDAR
            </a>
            <button
                class="md:hidden text-primary-container rounded-md p-2 hover:bg-primary/20 transition-colors"
            >
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </div>
</header>

{
    isHome && (
        <script>
            const homeHeader = document.querySelector("header") as HTMLElement | null;

            const toggleHeaderScrollState = () => {
                if (!homeHeader) return;

                if (window.scrollY > 24) {
                    homeHeader.setAttribute("data-scrolled", "true");
                } else {
                    homeHeader.removeAttribute("data-scrolled");
                }
            };

            toggleHeaderScrollState();
            window.addEventListener("scroll", toggleHeaderScrollState, {
                passive: true,
            });
        </script>
    )
}

<style>
    header[data-scrolled="true"] {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding-top: 0.6rem;
    }

    header[data-scrolled="true"] [data-home-shell="true"] {
        border-color: rgba(255, 255, 255, 0.75);
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.97) 0%,
            rgba(255, 255, 255, 0.92) 100%
        );
        box-shadow: 0 14px 34px rgba(0, 35, 89, 0.18);
    }

    header:not([data-scrolled="true"]) [data-home-shell="true"] {
        border-color: rgba(255, 255, 255, 0.5);
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.88) 0%,
            rgba(255, 255, 255, 0.78) 100%
        );
    }
</style>
