---
interface Props {
    variant?: "default" | "home";
}

const { variant = "default" } = Astro.props;
void variant;
---

<header
    class="sticky top-0 z-50 w-full px-3 pt-5 pb-0 md:px-6"
    data-mobile-header
>
    <div
        class="mx-auto flex w-full max-w-295 items-center justify-between rounded-lg bg-white px-6 py-2 border border-gray-100 transition-shadow"
        data-header-bar
    >
        <a href="/" class="shrink-0">
            <img
                src="/GoldTherapy.webp"
                alt="Gold Therapy"
                class="h-14 w-auto"
            />
        </a>

        <div class="hidden items-center gap-10 md:flex">
            <nav
                class="flex items-center gap-7 *:text-lg *:font-bold *:tracking-wide"
            >
                <a
                    class="text-on-surface transition-colors hover:text-primary-strong"
                    href="/">Inicio</a
                >
                <a
                    class="text-on-surface transition-colors hover:text-primary-strong"
                    href="/nosotros">Gold Therapy</a
                >
                <a
                    class="text-on-surface transition-colors hover:text-primary-strong"
                    href="/servicios">Servicios</a
                >
                <a
                    class="text-on-surface transition-colors hover:text-primary-strong"
                    href="/contacto">Contacto</a
                >
            </nav>

            <a
                href="https://wa.me/529982701550?text=Hola%2C%20quiero%20agendar%20una%20cita"
                class="flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-base font-bold uppercase tracking-wide text-on-primary transition-all hover:bg-primary-strong hover:translate-y-[-2px] hover:shadow-lg"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    ><g
                        fill="none"
                        stroke="#ffffff"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        ><rect width="20" height="18" x="2" y="4" rx="4"
                        ></rect><path d="M8 2v4m8-4v4M2 10h20"></path></g
                    ></svg
                >
                Agendar cita
            </a>
        </div>

        <button
            type="button"
            class="rounded-lg p-1.5 transition-colors hover:bg-surface-container-low md:hidden"
            aria-label="Abrir menu"
            aria-controls="mobile-menu-drawer"
            aria-expanded="false"
            data-mobile-menu-trigger
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    fill="var(--color-primary-strong)"
                    fill-rule="evenodd"
                    d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75M3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12m8.25 5.25a.75.75 0 0 1 .75-.75h8.25a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75"
                    clip-rule="evenodd"></path>
            </svg>
        </button>
    </div>

    <div
        class="mobile-menu-overlay fixed inset-0 z-60 bg-on-background/40 md:hidden"
        data-mobile-overlay
        aria-hidden="true"
    >
    </div>

    <aside
        id="mobile-menu-drawer"
        class="mobile-menu-drawer fixed left-0 top-0 z-70 h-screen w-[75vw] max-w-sm border-r bg-white md:hidden"
        style="border-color: var(--color-outline);"
        aria-hidden="true"
        data-mobile-drawer
    >
        <div class="flex h-full flex-col">
            <div
                class="flex items-center justify-between border-b px-5 py-4"
                style="border-color: var(--color-outline);"
            >
                <a href="/" class="inline-flex" data-mobile-menu-link>
                    <img
                        src="/GoldTherapy.webp"
                        alt="Gold Therapy"
                        class="h-10 w-auto"
                    />
                </a>
                <button
                    type="button"
                    class="rounded-lg p-2 text-on-surface transition-colors hover:bg-surface-container-low"
                    aria-label="Cerrar menu"
                    data-mobile-menu-close
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            fill="currentColor"
                            d="m12 10.586l4.95-4.95l1.414 1.414L13.414 12l4.95 4.95l-1.414 1.414L12 13.414l-4.95 4.95l-1.414-1.414l4.95-4.95l-4.95-4.95l1.414-1.414z"
                        ></path>
                    </svg>
                </button>
            </div>

            <nav class="flex flex-1 flex-col px-5 py-5">
                <a
                    href="/nosotros"
                    class="mobile-menu-link"
                    data-mobile-menu-link>Nosotros</a
                >
                <a
                    href="/servicios"
                    class="mobile-menu-link"
                    data-mobile-menu-link>Servicios</a
                >

                <div
                    class="flex flex-col gap-1 *:italic *:text-primary! *:pl-5!"
                >
                    <a
                        href="/servicios/fisioterapia-general"
                        class="mobile-menu-link"
                        data-mobile-menu-link
                    >
                        Fisioterapia General
                    </a>
                    <a
                        href="/servicios/rehabilitacion-post-operatoria"
                        class="mobile-menu-link"
                        data-mobile-menu-link
                    >
                        Rehabilitación Post Operatoria
                    </a>
                    <a
                        href="/servicios/terapia-deportiva"
                        class="mobile-menu-link"
                        data-mobile-menu-link
                    >
                        Terapia Deportiva
                    </a>
                    <a
                        href="/servicios/terapia-neurologica"
                        class="mobile-menu-link"
                        data-mobile-menu-link
                    >
                        Terapia Neurológica
                    </a>
                </div>

                <a
                    href="/contacto"
                    class="mobile-menu-link"
                    data-mobile-menu-link>Contacto</a
                >
                <a
                    href="https://wa.me/529982701550?text=Hola%2C%20quiero%20agendar%20una%20cita"
                    class="flex items-center gap-2 mt-5 w-full items-center justify-center rounded-md bg-primary px-5 py-3 font-bold uppercase tracking-wide text-on-primary"
                    data-mobile-menu-link
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        ><g
                            fill="none"
                            stroke="#ffffff"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            ><rect width="20" height="18" x="2" y="4" rx="4"
                            ></rect><path d="M8 2v4m8-4v4M2 10h20"></path></g
                        ></svg
                    >
                    Agendar cita
                </a>
            </nav>
        </div>
    </aside>
</header>

<script>
    // Da retroalimentación visual de que la página se desplazó: la barra
    // gana una sombra sutil en vez de quedar plana sobre el contenido.
    const headerBar =
        document.querySelector<HTMLDivElement>("[data-header-bar]");

    if (headerBar) {
        let ticking = false;

        const updateHeaderShadow = () => {
            headerBar.classList.toggle("shadow-md", window.scrollY > 8);
            ticking = false;
        };

        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    requestAnimationFrame(updateHeaderShadow);
                    ticking = true;
                }
            },
            { passive: true },
        );

        updateHeaderShadow();
    }

    const mobileHeader = document.querySelector("[data-mobile-header]");

    if (mobileHeader) {
        const menuTrigger = mobileHeader.querySelector(
            "[data-mobile-menu-trigger]",
        );
        const menuClose = mobileHeader.querySelector(
            "[data-mobile-menu-close]",
        );
        const menuOverlay = mobileHeader.querySelector("[data-mobile-overlay]");
        const menuDrawer = mobileHeader.querySelector("[data-mobile-drawer]");
        const menuLinks = mobileHeader.querySelectorAll(
            "[data-mobile-menu-link]",
        );

        const isMenuOpen = () =>
            mobileHeader.getAttribute("data-mobile-open") === "true";

        const openMenu = () => {
            mobileHeader.setAttribute("data-mobile-open", "true");
            document.body.style.overflow = "hidden";

            if (menuTrigger) {
                menuTrigger.setAttribute("aria-expanded", "true");
            }

            if (menuDrawer) {
                menuDrawer.setAttribute("aria-hidden", "false");
            }
        };

        const closeMenu = () => {
            mobileHeader.setAttribute("data-mobile-open", "false");
            document.body.style.overflow = "";

            if (menuTrigger) {
                menuTrigger.setAttribute("aria-expanded", "false");
            }

            if (menuDrawer) {
                menuDrawer.setAttribute("aria-hidden", "true");
            }
        };

        closeMenu();

        if (menuTrigger) {
            menuTrigger.addEventListener("click", () => {
                openMenu();
            });
        }

        if (menuClose) {
            menuClose.addEventListener("click", () => {
                closeMenu();
            });
        }

        if (menuOverlay) {
            menuOverlay.addEventListener("click", () => {
                closeMenu();
            });
        }

        document.addEventListener("pointerdown", (event) => {
            if (!isMenuOpen()) return;

            const target = event.target as Node | null;
            if (!target) return;

            const clickedInsideDrawer = menuDrawer?.contains(target);
            const clickedTrigger = menuTrigger?.contains(target);

            if (!clickedInsideDrawer && !clickedTrigger) {
                closeMenu();
            }
        });

        menuLinks.forEach((link) => {
            link.addEventListener("click", () => {
                closeMenu();
            });
        });

        window.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeMenu();
            }
        });
    }
</script>

<style>
    .mobile-menu-overlay {
        opacity: 0;
        pointer-events: none;
        transition: opacity 220ms ease;
    }

    .mobile-menu-drawer {
        transform: translateX(-100%);
        transition: transform 220ms ease;
    }

    [data-mobile-header][data-mobile-open="true"] .mobile-menu-overlay {
        opacity: 1;
        pointer-events: auto;
    }

    [data-mobile-header][data-mobile-open="true"] .mobile-menu-drawer {
        transform: translateX(0);
    }

    .mobile-menu-link {
        border-bottom: 1px solid var(--color-outline);
        padding: 0.95rem 0;
        font-size: 1.02rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--color-on-surface);
        transition: color 180ms ease;
    }

    .mobile-menu-link:hover {
        color: var(--color-primary-strong);
    }

    @media (min-width: 861px) {
        header[data-mobile-header] {
            padding-top: 20px;
        }
    }
</style>
