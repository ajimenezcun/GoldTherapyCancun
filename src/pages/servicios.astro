---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import services from "../data/services.json";

const patientFlow = [
    {
        step: "01",
        title: "Valoracion inicial",
        description:
            "Analizamos dolor, movilidad y objetivos funcionales para definir una ruta terapeutica realista.",
    },
    {
        step: "02",
        title: "Plan personalizado",
        description:
            "Diseñamos sesiones con tecnicas manuales y ejercicio terapeutico adaptado a tu condicion.",
    },
    {
        step: "03",
        title: "Seguimiento en casa",
        description:
            "Monitoreamos avance en cada visita y ajustamos intensidades para acelerar resultados sin riesgos.",
    },
    {
        step: "04",
        title: "Consolidacion",
        description:
            "Integramos rutinas simples para sostener la mejoria y prevenir recaidas en tu actividad diaria.",
    },
];

const homeBenefits = [
    "Mayor adherencia al tratamiento sin traslados.",
    "Ejercicios aplicados en tu entorno real.",
    "Acompañamiento cercano durante todo el proceso.",
    "Avance medible en movilidad, fuerza y autonomia.",
];
---

<BaseLayout
    title="Servicios de Fisioterapia a Domicilio en Cancún | Gold Therapy"
>
    <Header />

    <main class="services-main overflow-hidden">
        <section class="relative overflow-hidden py-28 text-white">
            <img
                src="/hero-section.jpg"
                alt="Servicios de fisioterapia en Cancun"
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(112deg,rgba(0,27,55,0.9)_6%,rgba(0,51,102,0.72)_54%,rgba(0,51,102,0.26)_100%)]"
            >
            </div>
            <div
                class="absolute -left-24 top-16 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
            >
            </div>

            <div class="relative z-10 mx-auto max-w-7xl px-6">
                <div>
                    <div
                        class="services-fade mb-6 flex flex-wrap items-center gap-2 text-sm font-semibold text-white/90 [animation-delay:80ms]"
                    >
                        <a href="/" class="transition-colors hover:text-primary"
                            >Inicio</a
                        >
                        <span aria-hidden="true">/</span>
                        <span class="text-primary">Servicios</span>
                    </div>

                    <p
                        class="services-fade text-sm font-black uppercase tracking-[0.2em] text-primary [animation-delay:140ms]"
                    >
                        Terapia fisica en Cancun
                    </p>
                    <h1
                        class="services-fade mt-4 max-w-4xl text-white! [animation-delay:220ms]"
                    >
                        Servicios diseñados para recuperar tu movilidad con
                        precision clinica
                    </h1>
                    <p
                        class="services-fade mt-6 max-w-2xl text-lg leading-relaxed text-white/90 [animation-delay:300ms] md:text-xl"
                    >
                        Tratamientos a domicilio con evaluacion funcional,
                        seguimiento continuo y protocolos adaptados a tu ritmo
                        de vida para disminuir dolor y mejorar tu autonomia.
                    </p>

                    <div
                        class="services-fade mt-9 flex flex-wrap gap-4 [animation-delay:380ms]"
                    >
                        <a
                            href="/contacto"
                            class="rounded-lg bg-primary px-8 py-3.5 text-lg font-extrabold text-on-primary transition-transform hover:-translate-y-1"
                        >
                            Agendar valoracion
                        </a>
                        <a
                            href="/a-domicilio"
                            class="rounded-lg border border-white/60 bg-white/12 px-8 py-3.5 text-lg font-bold text-white transition-colors hover:bg-white/20"
                        >
                            Como funciona en casa
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mb-12 max-w-3xl">
                    <h2>Terapia fisica a domicilio en Cancun</h2>
                    <p class="mt-4 text-lg text-on-surface-variant">
                        Elige el servicio que mejor se adapta a tu etapa de
                        recuperacion. Cada protocolo esta orientado a objetivos
                        medibles y avance progresivo.
                    </p>
                </div>

                <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {
                        services.map((service) => (
                            <article class="group overflow-hidden rounded-lg border border-secondary/10 bg-surface transition-all duration-300 hover:-translate-y-1.5">
                                <div class="relative overflow-hidden">
                                    <a
                                        href={service.href}
                                        aria-label={`Ver ${service.title}`}
                                    >
                                        <img
                                            src={service.image}
                                            alt={service.title}
                                            class="h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                        />
                                    </a>
                                </div>
                                <div class="space-y-4 p-6">
                                    <h3 class="text-2xl!">
                                        <a
                                            href={service.href}
                                            class="transition-colors hover:text-primary-container"
                                        >
                                            {service.title}
                                        </a>
                                    </h3>
                                    <p class="min-h-16 text-on-surface-variant">
                                        {service.description}
                                    </p>
                                    <a
                                        href={service.href}
                                        class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.14em] text-primary-container transition-all hover:gap-3 hover:text-secondary"
                                    >
                                        Ver detalle
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="18"
                                            height="18"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                fill="currentColor"
                                                d="M13.294 4.294a1 1 0 0 1 1.414 0l7 7a1 1 0 0 1 0 1.414l-7 7a1 1 0 1 1-1.414-1.414L18.586 13H3a1 1 0 1 1 0-2h15.586l-5.292-5.292a1 1 0 0 1 0-1.414"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="bg-surface-container-low py-20">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mb-10 max-w-3xl">
                    <h2>Como trabajamos con la mayoria de pacientes</h2>
                    <p class="mt-3 text-lg text-on-surface-variant">
                        Un flujo claro de valoracion, intervencion y seguimiento
                        para conseguir avances consistentes desde la primera
                        sesion.
                    </p>
                </div>

                <div class="relative">
                    <div
                        class="pointer-events-none absolute left-8 right-8 top-8 hidden h-px bg-linear-to-r from-secondary/0 via-secondary/25 to-secondary/0 lg:block"
                    >
                    </div>
                    <div class="grid gap-6 lg:grid-cols-4">
                        {
                            patientFlow.map((item) => (
                                <article class="relative rounded-lg border border-secondary/12 bg-white p-6">
                                    <p class="text-sm font-black tracking-[0.2em] text-primary-container">
                                        {item.step}
                                    </p>
                                    <h3 class="mt-3 text-2xl!">{item.title}</h3>
                                    <p class="mt-3 text-on-surface-variant">
                                        {item.description}
                                    </p>
                                </article>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white py-20">
            <div
                class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-2 lg:items-center"
            >
                <div
                    class="relative overflow-hidden rounded-lg border border-secondary/10"
                >
                    <img
                        alt="Terapia a domicilio"
                        class="h-full w-full object-cover"
                        src="/why.jpg"
                    />
                    <div
                        class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,51,102,0)_35%,rgba(0,51,102,0.65)_100%)]"
                    >
                    </div>
                    <p
                        class="absolute bottom-6 left-6 rounded-full bg-white/20 px-4 py-2 text-sm font-bold uppercase tracking-[0.15em] text-white backdrop-blur"
                    >
                        Atencion personalizada
                    </p>
                </div>

                <div class="space-y-8">
                    <h2>¿Por que fisioterapia a domicilio?</h2>
                    <p class="text-lg text-on-surface-variant">
                        Reducimos barreras de traslado para que tu recuperacion
                        sea continua, comoda y enfocada en objetivos medibles.
                    </p>
                    <ul class="grid gap-4 sm:grid-cols-2">
                        {
                            homeBenefits.map((benefit) => (
                                <li class="services-benefit-item rounded-lg border border-secondary/10 bg-surface px-5 py-4 text-secondary">
                                    {benefit}
                                </li>
                            ))
                        }
                    </ul>
                    <a
                        href="/contacto"
                        class="inline-flex rounded-lg bg-secondary px-8 py-3.5 text-lg font-bold text-white transition-colors hover:bg-primary-container"
                    >
                        Agendar una consulta
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer variant="home" />

    <style>
        .services-main {
            background:
                radial-gradient(
                    circle at 10% 12%,
                    rgba(228, 206, 131, 0.18),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 92% 24%,
                    rgba(30, 95, 171, 0.12),
                    transparent 30%
                ),
                linear-gradient(180deg, #f7f8fb 0%, #f5f5f5 24%, #f5f5f5 100%);
        }

        .services-fade {
            animation: servicesFade 700ms cubic-bezier(0.19, 1, 0.22, 1) both;
        }

        .services-benefit-item {
            position: relative;
            padding-left: 2.6rem;
            font-weight: 700;
        }

        .services-benefit-item::before {
            content: "";
            position: absolute;
            left: 1rem;
            top: 1.05rem;
            width: 0.95rem;
            height: 0.95rem;
            border-radius: 999px;
            background: linear-gradient(135deg, #e4ce83 0%, #d8b95c 100%);
            box-shadow: 0 0 0 4px rgba(228, 206, 131, 0.24);
        }

        @keyframes servicesFade {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</BaseLayout>
