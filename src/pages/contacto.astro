---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";

const whatsappUrl = "https://wa.me/525500000000";
---

<BaseLayout
    title="Contacto | Gold Therapy Cancún"
    description="Contáctanos para fisioterapia y rehabilitación física a domicilio en Cancún, México."
>
    <Header />

    <main class="contact-main overflow-hidden">
        <!-- Hero -->
        <section class="py-20">
            <div class="container-page relative z-10">
                <h1 class="block text-center">
                    Contacta a <span class="text-primary">Gold Therapy</span>
                </h1>
                <p
                    class="mt-5 text-center mx-auto md:max-w-2/3 text-lg leading-relaxed md:text-xl"
                >
                    Estamos para ayudarte con tu recuperación. Escríbenos para
                    evaluarte y orientarte con el tratamiento ideal para tu caso
                    de forma personalizada.
                </p>
            </div>
        </section>

        <section class="bg-white py-20">
            <div class="container-page">
                <div
                    class="flex justify-between border border-primary/20 rounded-lg shadow-xl flex-col p-3 md:flex-row"
                >
                    <div class="p-5 md:w-1/3">
                        <h2 class="text-3xl!">Atención en Cancún</h2>
                        <p class="py-2 flex flex-col gap-1">
                            <span
                                class="font-bold text-primary flex items-center gap-2"
                                ><svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    ><path
                                        fill="#cda448"
                                        d="m14.556 15.548l-.455.48s-1.083 1.139-4.038-1.972s-1.872-4.25-1.872-4.25l.287-.303c.706-.744.773-1.938.156-2.81L7.374 4.91C6.61 3.83 5.135 3.688 4.26 4.609L2.691 6.26c-.433.457-.723 1.048-.688 1.705c.09 1.68.808 5.293 4.812 9.51c4.247 4.47 8.232 4.648 9.861 4.487c.516-.05.964-.329 1.325-.709l1.42-1.496c.96-1.01.69-2.74-.538-3.446l-1.91-1.1c-.806-.463-1.787-.327-2.417.336"
                                        opacity=".5"></path><path
                                        fill="#cda448"
                                        d="M17 12a5 5 0 1 0-4.478-2.774a.82.82 0 0 1 .067.574l-.298 1.113a.65.65 0 0 0 .796.796l1.113-.298a.82.82 0 0 1 .574.067A5 5 0 0 0 17 12"
                                    ></path></svg
                                >Llámanos</span
                            >
                            <a href="tel:9982701550" class="font-bold text-lg"
                                >998 270 1550</a
                            >
                        </p>
                        <p class="py-2 flex flex-col gap-1">
                            <span
                                class="font-bold text-primary flex items-center gap-2"
                                ><svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    ><g
                                        fill="#cda448"
                                        fill-rule="evenodd"
                                        clip-rule="evenodd"
                                        ><path
                                            d="M12 4.428a7.572 7.572 0 0 0-6.183 11.944a.75.75 0 0 1 .077.731L4.82 19.586l3.147-.913a.75.75 0 0 1 .554.054A7.572 7.572 0 1 0 12 4.428M2.928 12a9.072 9.072 0 1 1 5.176 8.195L3.71 21.47a.75.75 0 0 1-.897-1.018l1.542-3.568A9.03 9.03 0 0 1 2.928 12"
                                        ></path><path
                                            d="M4.428 12a7.572 7.572 0 1 1 4.093 6.727a.75.75 0 0 0-.554-.054l-3.147.913l1.074-2.483a.75.75 0 0 0-.077-.731A7.53 7.53 0 0 1 4.428 12m8.944 2.753c-.372.22-1.187.287-2.736-1.262s-1.482-2.363-1.262-2.736c.56-.057 1.097-.432 1.595-.93c.369-.369.07-1.264-.666-2c-.737-.737-1.632-1.035-2-.667c-2.372 2.371-1.184 5.482 1 7.667c2.214 2.214 5.238 3.428 7.666 1c.369-.369.07-1.264-.666-2c-.737-.737-1.632-1.035-2-.667c-.499.498-.874 1.035-.93 1.595"
                                            opacity=".5"></path></g
                                    ></svg
                                >WhatsApp</span
                            >
                            <a
                                href={whatsappUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-bold text-lg">+52 998 270 1550</a
                            >
                        </p>
                        <p class="py-2 flex flex-col gap-1">
                            <span
                                class="font-bold text-primary flex items-center gap-2"
                                ><svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    width="24"
                                    height="24"
                                    ><rect
                                        width="16"
                                        height="12"
                                        x="4"
                                        y="6"
                                        fill="#cda448"
                                        fill-opacity=".25"
                                        rx="2"></rect><path
                                        fill="#cda448"
                                        d="M4 16V9.243a.15.15 0 0 1 .217-.134l6.441 3.22a3 3 0 0 0 2.684 0l6.44-3.22a.15.15 0 0 1 .218.134V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2"
                                    ></path></svg
                                >Email:</span
                            >
                            <a
                                href="mailto:info@goldtherapy.com.mx"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-bold text-lg"
                                >info@goldtherapy.com.mx</a
                            >
                        </p>
                        <h4 class="text-2xl mt-5">Horarios de atención</h4>
                        <p class="text-sm text-on-surface-variant block mb-3">
                            Atención únicamente con previa cita
                        </p>
                        <p class="flex flex-col text-lg font-bold mb-3">
                            <span class="font-normal text-base"
                                >Lunes a Viernes</span
                            >
                            10:00 AM a 6:00 PM
                        </p>
                        <p class="flex flex-col text-lg font-bold">
                            <span class="font-normal text-base">Sábados</span>
                            10:00 AM a 2:00 PM
                        </p>
                    </div>
                    <div class="flex-1">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d119095.60302074539!2d-86.9388048479858!3d21.123025281604097!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f4c2b05aef653db%3A0xce32b73c625fcd8a!2zQ2FuY8O6biwgUS5SLg!5e0!3m2!1ses-419!2smx!4v1787412390535!5m2!1ses-419!2smx"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            class="rounded-lg h-[320px] md:h-full"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                        ></iframe>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
