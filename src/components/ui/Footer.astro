<footer class="bg-secondary-container w-full pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 px-8 max-w-7xl mx-auto">
        <!-- Columna 1: Logo + descripción + redes -->
        <div class="col-span-1">
            <a href="/"
                ><img
                    src="/GoldTherapy.webp"
                    alt="Gold Therapy"
                    class="w-20 mb-4"
                /></a
            >
            <p class="text-blue-100/70 text-sm leading-relaxed mb-8">
                Elevando el estándar de la terapia física a través de la
                experiencia clínica, tecnología moderna y atención
                personalizada.
            </p>
            <div class="flex space-x-4">
                <a
                    class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary transition-colors"
                    href="#"
                >
                    <span class="material-symbols-outlined text-white text-xl"
                        ><svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            ><path
                                fill="#ffffff"
                                d="M12 2.04c-5.5 0-10 4.49-10 10.02c0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89c1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02"
