---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../ui/Header.astro";
import Footer from "../ui/Footer.astro";
import ServicesCarousel from "./ServicesCarousel.astro";

interface Props {
    serviceId: string;
    pageTitle: string;
    metaDescription: string;
    shortDescription: string;
    about: string;
    forYouPoints: string[];
    highlights: string[];
    heroImage: string;
}

const {
    serviceId,
    pageTitle,
    metaDescription,
    shortDescription,
    about,
    forYouPoints,
    highlights,
    heroImage,
}: Props = Astro.props;

const whatsappUrl = "https://wa.me/525500000000";
---

<BaseLayout title={`${pageTitle} | Gold Therapy`} description={metaDescription}>
    <Header />

    <main>
        <section class="relative overflow-hidden py-20 text-white">
            <img
                src={heroImage}
                alt={pageTitle}
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-secondary/70"></div>

            <div
                class="relative z-10 mx-auto flex max-w-7xl flex-col gap-6 px-6"
            >
                <div
                    class="flex flex-wrap items-center gap-2 text-sm font-bold"
                >
                    <a
                        href="/"
                        class="text-white/90 transition-colors hover:text-primary"
                    >
                        Inicio
                    </a>
                    <span aria-hidden="true">/</span>
                    <a
                        href="/servicios"
                        class="text-white/90 transition-colors hover:text-primary"
                    >
                        Servicios
                    </a>
                    <span aria-hidden="true">/</span>
                    <span class="text-primary">{pageTitle}</span>
                </div>

                <h1 class="max-w-3xl text-white!">{pageTitle}</h1>
                <p
                    class="max-w-3xl text-lg leading-relaxed text-white/90 md:text-xl"
                >
                    {shortDescription}
                </p>
            </div>
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-2">
                <article class="space-y-5">
                    <h2>Acerca del servicio</h2>
                    <p class="text-lg leading-relaxed text-on-surface-variant">
                        {about}
                    </p>
                </article>

                <article class="rounded-xl bg-surface-container-low p-8">
                    <h2 class="text-3xl!">¿Cuándo este servicio es para mí?</h2>
                    <ul class="mt-6 space-y-4">
                        {
                            forYouPoints.map((point) => (
                                <li class="flex items-start gap-3">
                                    <span
                                        class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
                                        aria-hidden="true"
                                    />
                                    <span class="text-lg text-on-surface-variant">
                                        {point}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            </div>
        </section>

        <section class="bg-surface py-20">
            <div class="mx-auto max-w-7xl px-6">
                <h2 class="mb-10">Highlights del servicio</h2>

                <div class="grid gap-6 lg:grid-cols-3">
                    {
                        highlights.map((highlight) => (
                            <article class="rounded-xl border border-primary/30 bg-white p-6 shadow-sm">
                                <h3 class="text-xl!">{highlight}</h3>
                            </article>
                        ))
                    }

                    <article
                        class="rounded-xl bg-secondary p-6 text-white lg:col-span-3"
                    >
                        <h3 class="text-2xl! text-white!">
                            Atención a domicilio en Cancún
                        </h3>
                        <p class="mt-3 text-lg text-white/90">
                            Llevamos este servicio hasta tu hogar con un enfoque
                            personalizado, ideal para pacientes con movilidad
                            limitada o agendas complejas.
                        </p>
                        <ul
                            class="mt-5 flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-5"
                        >
                            <li
                                class="rounded-md bg-white/15 px-4 py-2 font-semibold"
                            >
                                Horarios flexibles
                            </li>
                            <li
                                class="rounded-md bg-white/15 px-4 py-2 font-semibold"
                            >
                                Evaluación individual en casa
                            </li>
                            <li
                                class="rounded-md bg-white/15 px-4 py-2 font-semibold"
                            >
                                Plan de tratamiento adaptado a tu espacio
                            </li>
                        </ul>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-surface-container-low py-20">
            <div class="mx-auto mb-10 max-w-7xl px-6 text-center">
                <h2>Conoce otros servicios</h2>
                <p class="mt-3 text-lg text-on-surface-variant">
                    Explora tratamientos relacionados para complementar tu
                    recuperación.
                </p>
            </div>
            <ServicesCarousel excludeId={serviceId} />
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto max-w-7xl px-6">
                <div
                    class="rounded-2xl bg-primary/30 p-10 text-center shadow-sm"
                >
                    <h2 class="mb-4">
                        ¿Necesitas más información sobre este servicio?
                    </h2>
                    <p
                        class="mx-auto mb-8 max-w-3xl text-lg text-on-surface-variant"
                    >
                        Escríbenos por WhatsApp y te ayudamos a evaluar tu caso
                        para iniciar tu tratamiento de forma segura y
                        personalizada.
                    </p>
                    <a
                        href={whatsappUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex rounded-lg bg-[#25d366] px-8 py-4 text-lg font-bold text-white transition-colors hover:bg-[#1ebe57]"
                    >
                        Solicitar información por WhatsApp
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
