---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../ui/Header.astro";
import Footer from "../ui/Footer.astro";
import ServicesCarousel from "./ServicesCarousel.astro";

interface ServiceHighlight {
    title: string;
    description: string;
}

interface Props {
    serviceId: string;
    pageTitle: string;
    metaDescription: string;
    shortDescription: string;
    aboutIntro: string;
    serviceDetails: string[];
    forYouPoints: string[];
    highlights: ServiceHighlight[];
    heroImage: string;
}

const {
    serviceId,
    pageTitle,
    metaDescription,
    shortDescription,
    aboutIntro,
    serviceDetails,
    forYouPoints,
    highlights,
    heroImage,
}: Props = Astro.props;

const whatsappUrl = "https://wa.me/525500000000";
---

<BaseLayout title={`${pageTitle} | Gold Therapy`} description={metaDescription}>
    <Header />

    <main class="overflow-hidden">
        <section
            class="container-page border border-primary/20 p-5 rounded-lg shadow-xl mt-10 mb-20 flex flex-col w-11/12 md:flex-row justify-between gap-10"
        >
            <article class="md:w-1/2">
                <h1 class="block mb-3">{pageTitle}</h1>
                <div
                    class="mb-5 flex flex-wrap items-center gap-2 text-sm font-semibold"
                >
                    <a href="/" class="transition-colors hover:text-primary"
                        >Inicio</a
                    >
                    <span aria-hidden="true">/</span>
                    <a
                        href="/servicios"
                        class="transition-colors hover:text-primary"
                        >Servicios</a
                    >
                    <span aria-hidden="true">/</span>
                    <span class="text-primary">{pageTitle}</span>
                </div>
                <p class="text-lg">{shortDescription}</p>
            </article>
            <img
                src={heroImage}
                alt={pageTitle}
                class="object-cover rounded-lg"
            />
        </section>

        <section class="bg-white py-20">
            <div
                class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[1.3fr_0.8fr]"
            >
                <article class="space-y-8">
                    <div class="space-y-4">
                        <h2>¿En qué consiste este servicio?</h2>
                        <p
                            class="text-lg leading-relaxed text-on-surface-variant"
                        >
                            {aboutIntro}
                        </p>
                    </div>

                    <div>
                        <h3 class="text-2xl!">¿Qué trabajamos en sesión?</h3>
                        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                            {
                                serviceDetails.map((detail) => (
                                    <li class="service-detail-item rounded-lg border border-secondary/10 bg-white px-4 py-3 text-on-surface-variant">
                                        {detail}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </article>

                <article
                    class="rounded-lg bg-surface-container-low p-5 lg:mt-12"
                >
                    <h3 class="text-2xl!">¿Cuándo este servicio es para mí?</h3>
                    <ul class="mt-5 space-y-4">
                        {
                            forYouPoints.map((point) => (
                                <li class="flex items-start gap-3">
                                    <span
                                        class="mt-2 inline-block h-2 w-2 shrink-0 rounded-full bg-primary"
                                        aria-hidden="true"
                                    />
                                    <span class="text-on-surface-variant">
                                        {point}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            </div>
        </section>

        <section class="bg-white py-10">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mb-10 mx-auto">
                    <h2 class="text-center">
                        Beneficios de la <span class="text-primary"
                            >{pageTitle}</span
                        >
                    </h2>
                    <p
                        class="mt-3 text-lg mx-auto text-center text-on-surface-variant"
                    >
                        Resultados clínicos de la <b>{pageTitle}</b> esperados en
                        el transcurso del tratamiento.
                    </p>
                </div>

                <div class="relative">
                    <div
                        class="pointer-events-none absolute left-8 right-8 top-8 hidden h-px bg-linear-to-r from-secondary/0 via-secondary/25 to-secondary/0 lg:block"
                    >
                    </div>

                    <div class="grid gap-6 lg:grid-cols-3">
                        {
                            highlights.map((highlight, index) => (
                                <article class="relative rounded-lg border border-secondary/12 bg-white p-6">
                                    <p class="text-sm font-black tracking-[0.2em] text-primary-container">
                                        0{index + 1}
                                    </p>
                                    <h3 class="mt-3 text-2xl!">
                                        {highlight.title}
                                    </h3>
                                    <p class="mt-3 text-on-surface-variant">
                                        {highlight.description}
                                    </p>
                                </article>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto mb-10 max-w-7xl px-6 text-center">
                <h2>Conoce otros servicios</h2>
                <p class="mt-3 text-lg text-on-surface-variant">
                    Explora otros tratamientos realizados por Gold Therapy.
                </p>
            </div>
            <ServicesCarousel excludeId={serviceId} />
        </section>

        <section class="bg-white pb-20">
            <div class="mx-auto max-w-7xl px-6">
                <div
                    class="rounded-lg p-10 text-center shadow-lg bg-surface-container-low border border-primary/20"
                >
                    <h2 class="mb-4">
                        ¿Necesitas más información sobre este servicio?
                    </h2>
                    <p class="mx-auto mb-8 text-lg text-on-surface-variant">
                        Escríbenos por whatsapp para ayudarte a evaluar tu caso
                        e iniciar tu tratamiento de forma personalizada.
                    </p>
                    <a
                        href={whatsappUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-fit mx-auto rounded-lg bg-primary px-5 py-3 flex items-center gap-1 uppercase text-base font-bold text-white transition-all hover:bg-primary-strong hover:translate-y-[-2px] hover:shadow-lg"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            ><path
                                fill="#ffffff"
                                d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23c-1.48 0-2.93-.39-4.19-1.15l-.3-.17l-3.12.82l.83-3.04l-.2-.32a8.2 8.2 0 0 1-1.26-4.38c.01-4.54 3.7-8.24 8.25-8.24M8.53 7.33c-.16 0-.43.06-.66.31c-.22.25-.87.86-.87 2.07c0 1.22.89 2.39 1 2.56c.14.17 1.76 2.67 4.25 3.73c.59.27 1.05.42 1.41.53c.59.19 1.13.16 1.56.1c.48-.07 1.46-.6 1.67-1.18s.21-1.07.15-1.18c-.07-.1-.23-.16-.48-.27c-.25-.14-1.47-.74-1.69-.82c-.23-.08-.37-.12-.56.12c-.16.25-.64.81-.78.97c-.15.17-.29.19-.53.07c-.26-.13-1.06-.39-2-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.12-.24-.01-.39.11-.5c.11-.11.27-.29.37-.44c.13-.14.17-.25.25-.41c.08-.17.04-.31-.02-.43c-.06-.11-.56-1.35-.77-1.84c-.2-.48-.4-.42-.56-.43c-.14 0-.3-.01-.47-.01"
                            ></path></svg
                        >
                        Escríbenos
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
