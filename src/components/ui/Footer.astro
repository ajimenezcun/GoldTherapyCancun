            <ul
                class="space-y-3 *:text-blue-100/60 *:transition-all *:hover:text-white"
            >
                <li>
                    <a class="" href="#">Fisioterapia</a>
                </li>
                <li>
                    <a class="" href="#">Masaje Deportivo</a>
                </li>
                <li>
                    <a class="" href="#">Quiropraxia</a>
                </li>
                <li>
                    <a class="" href="#">Rehabilitación Post-Op</a>
                </li>
            </ul>
        </div>

        <!-- Columna 3: Links rápidos -->
        <div>
            <h4 class="!text-primary font-bold mb-5 uppercase">Información</h4>
            <ul
                class="space-y-3 *:text-blue-100/60 *:transition-all *:hover:text-white"
            >
                <li>
                    <a class="" href="/">Pagina de Inicio</a>
                </li>
                <li>
                    <a class="" href="/sobre-mi">Sobre Mí</a>
                </li>
                <li>
                    <a class="" href="/servicios">Servicios</a>
                </li>
                <li>
                    <a class="" href="/a-domicilio">Fisioterapia a Domicilio</a>
                </li>
                <li>
                    <a href="/contacto">Contacto</a>
                </li>
            </ul>
        </div>

        <!-- Columna 4: Newsletter -->
        <div>
            <h4 class="!text-primary font-bold mb-5 uppercase">Legal</h4>
            <ul
                class="space-y-3 *:text-blue-100/60 *:transition-all *:hover:text-white"
            >
                <li>
                    <a class="" href="/politicas-privacidad"
                        >Política de Privacidad</a
                    >
                </li>
                <li>
                    <a class="" href="/terminos-servicio"
                        >Términos de Servicio</a
                    >
                </li>
                <li>
                    <a class="" href="/accesibilidad">Accesibilidad</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Barra inferior -->
    <div
        class="max-w-7xl mx-auto px-8 mt-10 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6"
    >
