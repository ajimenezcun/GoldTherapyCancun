---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import services from "../data/services.json";

const careSteps = [
    {
        title: "Evaluación inicial",
        description:
            "Valoramos tu caso a fondo: historial, movilidad y origen del dolor, para entender qué lo está causando.",
    },
    {
        title: "Plan de tratamiento",
        description:
            "Diseñamos un programa personalizado con objetivos claros y un estimado de sesiones para tu recuperación.",
    },
    {
        title: "Seguimiento terapéutico",
        description:
            "Sesión a sesión ajustamos el tratamiento según tu evolución, siempre con el mismo terapeuta acompañándote.",
    },
    {
        title: "Alta médica",
        description:
            "Evaluamos tu recuperación y te compartimos indicaciones para mantener resultados y prevenir recaídas.",
    },
];

const treatments = [
    {
        title: "Terapia manual",
        description:
            "Movilización de articulaciones, estiramientos y técnicas de masaje para aliviar dolor y mejorar movilidad.",
    },
    {
        title: "Ejercicio terapéutico",
        description:
            "Rutinas personalizadas para fortalecer músculos, mejorar postura y prevenir lesiones.",
    },
    {
        title: "Electroterapia",
        description:
            "Uso de corrientes eléctricas para estimular músculos, reducir inflamación y acelerar la recuperación.",
    },
    {
        title: "Terapia con calor y frío",
        description:
            "Aplicación de compresas calientes o frías para aliviar dolor, reducir inflamación y mejorar circulación.",
    },
    {
        title: "Vendaje neuromuscular",
        description:
            "Técnica de vendaje elástico que ayuda a reducir dolor, mejorar circulación y apoyar músculos y articulaciones.",
    },
];
---

<BaseLayout
    title="Servicios de Fisioterapia a Domicilio en Cancún | Gold Therapy"
>
    <Header />

    <main class="overflow-hidden">
        <section class="py-10">
            <div
                class="container-page flex flex-col relative py-12 overflow-x-hidden sm:py-20 md:flex-row md:bg-[url('/hero-homepage.webp')] md:bg-contain md:bg-right md:bg-no-repeat"
            >
                <div class="relative z-20 md:w-1/2" data-hero-copy>
                    <h1 class="text-4xl sm:text-5xl">
                        Servicios de Fisioterapia y Rehabilitación Fisica en
                        <span class="text-primary">Cancún</span>
                    </h1>
                    <p
                        class="mt-6 text-xl leading-relaxed text-on-surface-variant"
                    >
                        Tratamientos a domicilio con evaluacion funcional,
                        seguimiento continuo y protocolos adaptados a tu ritmo
                        de vida para disminuir dolor y mejorar tu autonomia.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-4">
                        <a
                            href="#"
                            class="rounded-md flex gap-1 items-center bg-primary px-5 py-3 font-bold uppercase tracking-wide text-on-primary transition-all hover:bg-primary-strong hover:translate-y-[-2px] hover:shadow-lg"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="20"
                                height="20"
                                ><path
                                    fill="#ffffff"
                                    d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23c-1.48 0-2.93-.39-4.19-1.15l-.3-.17l-3.12.82l.83-3.04l-.2-.32a8.2 8.2 0 0 1-1.26-4.38c.01-4.54 3.7-8.24 8.25-8.24M8.53 7.33c-.16 0-.43.06-.66.31c-.22.25-.87.86-.87 2.07c0 1.22.89 2.39 1 2.56c.14.17 1.76 2.67 4.25 3.73c.59.27 1.05.42 1.41.53c.59.19 1.13.16 1.56.1c.48-.07 1.46-.6 1.67-1.18s.21-1.07.15-1.18c-.07-.1-.23-.16-.48-.27c-.25-.14-1.47-.74-1.69-.82c-.23-.08-.37-.12-.56.12c-.16.25-.64.81-.78.97c-.15.17-.29.19-.53.07c-.26-.13-1.06-.39-2-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.12-.24-.01-.39.11-.5c.11-.11.27-.29.37-.44c.13-.14.17-.25.25-.41c.08-.17.04-.31-.02-.43c-.06-.11-.56-1.35-.77-1.84c-.2-.48-.4-.42-.56-.43c-.14 0-.3-.01-.47-.01"
                                ></path></svg
                            >
                            Agendar Valoración
                        </a>
                    </div>
                </div>

                <img
                    src="/hero-homepage.webp"
                    alt="Sesión de fisioterapia en Gold Therapy"
                    class="absolute bottom-0 z-10 w-full md:hidden"
                />
            </div>
        </section>

        <section class="container-page py-10 sm:py-20">
            <div class="mt-14 flex flex-col">
                {
                    services.map((service, index) => (
                        <article
                            class:list={[
                                "group flex flex-col py-8 transition-all sm:flex-row",
                                index !== services.length - 1 &&
                                    "border-b border-gray-200",
                            ]}
                        >
                            <div class="overflow-hidden sm:w-2/5 [mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_75%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_35%,transparent_75%)]">
                                <img
                                    src={service.image}
                                    alt={service.title}
                                    class="h-56 w-full object-cover transition-transform duration-300 group-hover:scale-105 sm:h-full"
                                />
                            </div>
                            <div class="flex flex-1 flex-col justify-center p-8">
                                <h3 class="text-xl !text-primary text-center md:text-left">
                                    <a
                                        href={service.link}
                                        class="hover:underline"
                                    >
                                        {service.title}
                                    </a>
                                </h3>
                                <p class="mt-3 leading-relaxed text-on-surface-variant text-center md:text-left">
                                    {service.description}
                                </p>
                                <a
                                    href={service.link}
                                    class="mt-5 flex w-fit mx-auto md:mx-0 items-center gap-1 font-bold text-secondary transition-all hover:gap-2"
                                >
                                    Saber más
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                        width="18"
                                        height="18"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M5 12h14" />
                                        <path d="m12 5 7 7-7 7" />
                                    </svg>
                                </a>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <section class="container-page py-10 sm:py-20">
            <h2 data-reveal class="text-center text-[32px]">
                Cómo trabajamos contigo
            </h2>
            <p
                class="mx-auto mt-4 max-w-160 text-center text-lg leading-relaxed text-on-surface-variant"
            >
                Desde tu primer mensaje hasta tu alta médica, te acompañamos con
                un proceso claro en cada etapa de tu recuperación.
            </p>

            <div class="relative mt-16">
                <div
                    class="absolute left-5 top-6 bottom-6 w-0.5 bg-secondary/25 lg:left-0 lg:right-0 lg:top-6 lg:bottom-auto lg:h-0.5 lg:w-auto"
                >
                </div>
                <div class="relative grid gap-10 lg:grid-cols-4 lg:gap-6">
                    {
                        careSteps.map((step, index) => (
                            <div class="relative flex items-start gap-5 lg:flex-col lg:items-center lg:gap-0 lg:text-center">
                                <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary font-bold text-white">
                                    {index + 1}
                                </span>
                                <div class="lg:mt-5">
                                    <h3 class="!text-xl !text-primary">
                                        {step.title}
                                    </h3>
                                    <p class="mt-2 text-base leading-relaxed text-on-surface-variant">
                                        {step.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="bg-surface-container-low section-y">
            <div class="container-page">
                <h2 class="text-center mb-5">Tratamientos y Técnicas</h2>
                <p class="text-lg text-center max-w-2/3 mx-auto">
                    En Gold Therapy ofrecemos una variedad de técnicas y
                    tratamientos complementarios de fisioterapia para optimizar
                    y acelerar los resultados de recuperación, también contamos
                    con tratamientos de medicina complementaria.
                </p>

                <div class="mt-20 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
                    {
                        treatments.map((treatment, index) => (
                            <div class="mb-4">
                                <div class="flex items-center gap-1">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 256 256"
                                        width="24"
                                        height="24"
                                    >
                                        <g fill="#cda448">
                                            <>
                                                <path
                                                    d="m160 160l-50.75 50.75a45.26 45.26 0 0 1-64 0a45.26 45.26 0 0 1 0-64L96 96Z"
                                                    opacity=".2"
                                                />
                                                <path d="M216.43 39.6a53.27 53.27 0 0 0-75.33 0L39.6 141.09a53.26 53.26 0 0 0 75.32 75.31l101.51-101.49a53.32 53.32 0 0 0 0-75.31M103.61 205.09a37.26 37.26 0 0 1-52.7-52.69L96 107.31L148.7 160Zm101.5-101.49L160 148.69L107.32 96l45.1-45.09a37.26 37.26 0 0 1 52.69 52.69m-15.43-21.26a8 8 0 0 1 0 11.32l-24 24a8 8 0 1 1-11.31-11.32l24-24a8 8 0 0 1 11.31 0" />
                                            </>
                                        </g>
                                    </svg>
                                    <h3 class="!text-xl !text-primary">
                                        {treatment.title}
                                    </h3>
                                </div>
                                <p class="mt-2 text-base leading-relaxed text-on-surface-variant">
                                    {treatment.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <Footer variant="home" />
</BaseLayout>
