---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import ServicesCarousel from "../components/sections/ServicesCarousel.astro";
---

<BaseLayout
    title="Servicios de Fisioterapia a Domicilio en Cancún | Gold Therapy"
>
    <Header />

    <main>
        <section
            class="relative py-10 bg-cover bg-center flex items-center justify-center text-center text-white"
            style="background-image: url('/hero-section.jpg')"
        >
            <div class="absolute inset-0 bg-black/20"></div>
            <div class="relative z-10 max-w-10/12 px-6">
                <h1 class="mb-2">Servicios de Fisioterapia en Cancún</h1>
                <div
                    class="text-black font-semibold flex items-center justify-center gap-2 mb-6"
                >
                    <a href="/" class="hover:underline">Gold Therapy</a>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        ><path
                            fill="none"
                            stroke="#000000"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M15 4L8 20"></path></svg
                    >
                    <span class="text-secondary">Servicios</span>
                </div>
                <p class="text-lg md:text-xl">
                    Descubre cómo nuestros servicios de fisioterapia a domicilio
                    en Cancún pueden ayudarte a recuperar tu bienestar desde la
                    comodidad de tu hogar.
                </p>
            </div>
        </section>
        <section class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-6 text-center mb-10">
                <h2 class="mb-3">Terapia Física a Domicilio en Cancún</h2>
                <p class="max-w-10/12 mx-auto text-lg">
                    En Gold Therapy, ofrecemos servicios de fisioterapia a
                    domicilio en Cancún diseñados para brindarte comodidad,
                    atención personalizada y resultados efectivos.
                </p>
            </div>

            <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-3 gap-10">
                <article>
                    <img
                        src="service-1.jpg"
                        alt=""
                        class="rounded-lg block mx-auto mb-5 w-full object-cover"
                    />
                    <h3 class="mb-3">Fisioterapia General</h3>
                    <p class="mb-5">
                        Tratamientos personalizados para mejorar la movilidad y
                        reducir el dolor.
                    </p>
                    <a
                        href="/servicios/rehabilitacion-post-operatoria"
                        class="text-primary-container text-sm uppercase font-semibold transition-all duration-200 hover:text-black"
                        >Más información</a
                    >
                </article>
                <article>
                    <img
                        src="service-2.jpg"
                        alt=""
                        class="rounded-lg block mx-auto mb-5 w-full object-cover"
                    />
                    <h3 class="mb-3">Rehabilitación Postoperatoria</h3>
                    <p class="mb-5">
                        Recuperación efectiva después de cirugías con atención
                        especializada.
                    </p>
                    <a
                        href="/servicios/fisioterapia-general"
                        class="text-primary-container text-sm uppercase font-semibold transition-all duration-200 hover:text-black"
                        >Más información</a
                    >
                </article>
                <article>
                    <img
                        src="service-3.jpg"
                        alt=""
                        class="rounded-lg block mx-auto mb-5 w-full object-cover"
                    />
                    <h3 class="mb-3">Fisioterapia Deportiva</h3>
                    <p class="mb-5">
                        Programas de rehabilitación y prevención de lesiones
                        para atletas.
                    </p>
                    <a
                        href="/servicios/fisioterapia-deportiva"
                        class="text-primary-container text-sm uppercase font-semibold transition-all duration-200 hover:text-black"
                        >Más información</a
                    >
                </article>
                <article>
                    <img
                        src="service-4.jpg"
                        alt=""
                        class="rounded-lg block mx-auto mb-5 w-full object-cover"
                    />
                    <h3 class="mb-3">Fisioterapia Neurológica</h3>
                    <p class="mb-5">
                        Tratamientos para mejorar la función y calidad de vida
                        en condiciones neurológicas.
                    </p>
                    <a
                        href="/servicios/fisioterapia-neurologica"
                        class="text-primary-container text-sm uppercase font-semibold transition-all duration-200 hover:text-black"
                        >Más información</a
                    >
                </article>
            </div>
        </section>

        <section
            class="py-20 overflow-hidden bg-surface-container-low max-w-7xl mx-auto px-6"
        >
            <div
                class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center"
            >
                <!-- Imagen / video -->
                <div class="relative">
                    <img
                        alt="Terapia de quiropraxia"
                        class="w-full object-cover rounded-lg"
                        src="/why.jpg"
                    />
                </div>

                <!-- Texto -->
                <div class="space-y-8">
                    <h2>¿Por qué Fisioterapia a domicilio?</h2>
                    <p class="text-on-surface-variant text-lg">
                        En muchas ocasiones, el dolor crónico y las limitaciones
                        de movilidad pueden hacer que salir de casa para recibir
                        tratamiento sea un desafío. La fisioterapia a domicilio
                        ofrece comodidad, atención personalizada y un entorno
                        familiar que puede acelerar tu recuperación.
                    </p>
                    <ul class="space-y-4">
                        <li class="flex items-center gap-2">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                ><path
                                    fill="#E4CE83"
                                    d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2s10 4.477 10 10"
                                    opacity=".5"></path><path
                                    fill="#E4CE83"
                                    d="M16.03 8.97a.75.75 0 0 1 0 1.06l-5 5a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 1 1 1.06-1.06l1.47 1.47l2.235-2.235L14.97 8.97a.75.75 0 0 1 1.06 0"
                                ></path></svg
                            >
                            <span class="font-bold text-secondary"
                                >Mejora de postura y movilidad</span
                            >
                        </li>
                        <li class="flex items-center gap-2">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                ><path
                                    fill="#E4CE83"
                                    d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2s10 4.477 10 10"
                                    opacity=".5"></path><path
                                    fill="#E4CE83"
                                    d="M16.03 8.97a.75.75 0 0 1 0 1.06l-5 5a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 1 1 1.06-1.06l1.47 1.47l2.235-2.235L14.97 8.97a.75.75 0 0 1 1.06 0"
                                ></path></svg
                            >
                            <span class="font-bold text-secondary"
                                >Descarga de tensión muscular</span
                            >
                        </li>
                        <li class="flex items-center gap-2">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                ><path
                                    fill="#E4CE83"
                                    d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2s10 4.477 10 10"
                                    opacity=".5"></path><path
                                    fill="#E4CE83"
                                    d="M16.03 8.97a.75.75 0 0 1 0 1.06l-5 5a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 1 1 1.06-1.06l1.47 1.47l2.235-2.235L14.97 8.97a.75.75 0 0 1 1.06 0"
                                ></path></svg
                            >
                            <span class="font-bold text-secondary"
                                >Alivio del dolor no invasivo</span
                            >
                        </li>
                    </ul>
                    <a
                        href="#"
                        class="bg-primary text-white px-8 py-4 rounded-lg font-bold hover:scale-105 transition-all duration-300 shadow-lg block w-fit"
                    >
                        Agendar una Consulta
                    </a>
                </div>
            </div>
        </section>

        <Footer />
    </main>
</BaseLayout>
