---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import ServicesCarousel from "../components/sections/ServicesCarousel.astro";

const whatsappUrl = "https://wa.me/525500000000";
---

<BaseLayout
    title="Rehabilitación Física a Domicilio en Cancún | Gold Therapy"
    description="Conoce en qué consiste la rehabilitación física a domicilio en Cancún y sus principales ventajas para tu recuperación."
>
    <Header />

    <main class="homecare-main overflow-hidden">
        <section class="relative overflow-hidden py-24 text-white">
            <img
                src="/hero-section.jpg"
                alt="Rehabilitación física a domicilio en Cancún"
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(112deg,rgba(0,27,55,0.9)_6%,rgba(0,51,102,0.72)_54%,rgba(0,51,102,0.26)_100%)]"
            >
            </div>
            <div
                class="absolute -left-24 top-16 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
            >
            </div>

            <div class="relative z-10 mx-auto max-w-7xl px-6">
                <div
                    class="mb-5 flex flex-wrap items-center gap-2 text-sm font-semibold text-white/90"
                >
                    <a href="/" class="transition-colors hover:text-primary"
                        >Inicio</a
                    >
                    <span aria-hidden="true">/</span>
                    <span class="text-primary">A domicilio</span>
                </div>

                <h1 class="max-w-4xl text-white!">
                    Rehabilitación física a domicilio en Cancún
                </h1>
                <p
                    class="mt-5 max-w-3xl text-lg leading-relaxed text-white/90 md:text-xl"
                >
                    Un servicio profesional, humano y personalizado para que
                    recuperes tu movilidad sin salir de casa. Diseñamos tu
                    tratamiento según tu diagnóstico, tu ritmo y tus objetivos
                    de bienestar.
                </p>
            </div>
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-2">
                <article class="space-y-5">
                    <h2>
                        ¿En qué consiste la rehabilitación física a domicilio?
                    </h2>
                    <p class="text-lg leading-relaxed text-on-surface-variant">
                        Es un modelo terapéutico en el que la valoración, el
                        tratamiento y el seguimiento se realizan en tu hogar.
                        Esto permite adaptar cada sesión a tu entorno real para
                        lograr una recuperación funcional, práctica y
                        sostenible.
                    </p>
                    <p class="text-lg leading-relaxed text-on-surface-variant">
                        En Gold Therapy combinamos terapia manual, ejercicio
                        terapéutico y educación del movimiento para ayudarte a
                        disminuir dolor, mejorar fuerza y retomar tus
                        actividades cotidianas con seguridad.
                    </p>
                </article>

                <article
                    class="rounded-2xl border border-secondary/10 bg-surface-container-low p-8 lg:mt-8"
                >
                    <h3 class="mb-5 text-2xl!">
                        ¿Para quién está recomendado?
                    </h3>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <span
                                class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
                            ></span>
                            <span class="text-lg text-on-surface-variant">
                                Personas con dolor lumbar, cervical o articular
                                recurrente.
                            </span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
                            ></span>
                            <span class="text-lg text-on-surface-variant">
                                Pacientes en recuperación posterior a cirugía o
                                lesión.
                            </span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
                            ></span>
                            <span class="text-lg text-on-surface-variant">
                                Adultos mayores que requieren atención funcional
                                continua.
                            </span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
                            ></span>
                            <span class="text-lg text-on-surface-variant">
                                Personas con agendas complejas que buscan
                                terapia efectiva en casa.
                            </span>
                        </li>
                    </ul>
                </article>
            </div>
        </section>

        <section class="bg-surface py-20">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mb-12 max-w-3xl">
                    <h2>Ventajas de la rehabilitación a domicilio en Cancún</h2>
                    <p class="mt-4 text-lg text-on-surface-variant">
                        Más que comodidad, este enfoque mejora la adherencia al
                        tratamiento y facilita resultados más rápidos al
                        trabajar dentro de tu rutina diaria.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    <article
                        class="rounded-2xl border border-secondary/12 bg-white p-7 shadow-[0_14px_34px_rgba(0,35,90,0.08)]"
                    >
                        <h3 class="mb-3 text-xl!">
                            Comodidad y ahorro de tiempo
                        </h3>
                        <p class="text-on-surface-variant">
                            Evitas traslados, tráfico y esperas. Tu terapia se
                            integra a tu día sin interrumpir tus
                            responsabilidades.
                        </p>
                    </article>

                    <article
                        class="rounded-2xl border border-secondary/12 bg-white p-7 shadow-[0_14px_34px_rgba(0,35,90,0.08)]"
                    >
                        <h3 class="mb-3 text-xl!">Atención personalizada</h3>
                        <p class="text-on-surface-variant">
                            Cada sesión se adapta a tu evolución clínica, tus
                            metas y tus necesidades específicas en casa.
                        </p>
                    </article>

                    <article
                        class="rounded-2xl border border-secondary/12 bg-white p-7 shadow-[0_14px_34px_rgba(0,35,90,0.08)]"
                    >
                        <h3 class="mb-3 text-xl!">Mayor adherencia</h3>
                        <p class="text-on-surface-variant">
                            Al facilitar el acceso al tratamiento, es más
                            probable mantener constancia y lograr mejores
                            resultados a mediano plazo.
                        </p>
                    </article>

                    <article
                        class="rounded-2xl border border-secondary/12 bg-white p-7 shadow-[0_14px_34px_rgba(0,35,90,0.08)]"
                    >
                        <h3 class="mb-3 text-xl!">
                            Recuperación funcional real
                        </h3>
                        <p class="text-on-surface-variant">
                            Entrenamos movimientos en el espacio donde vives,
                            para transferir mejoras directamente a tus
                            actividades cotidianas.
                        </p>
                    </article>

                    <article
                        class="rounded-2xl border border-secondary/12 bg-white p-7 shadow-[0_14px_34px_rgba(0,35,90,0.08)]"
                    >
                        <h3 class="mb-3 text-xl!">Acompañamiento cercano</h3>
                        <p class="text-on-surface-variant">
                            Monitoreamos tus avances y ajustamos el plan
                            terapéutico de forma continua para potenciar tu
                            recuperación.
                        </p>
                    </article>

                    <article
                        class="rounded-2xl bg-secondary p-7 text-white shadow-[0_16px_36px_rgba(0,35,90,0.2)]"
                    >
                        <h3 class="mb-3 text-xl! text-white!">
                            Cobertura en Cancún
                        </h3>
                        <p class="text-white/90">
                            Brindamos servicio en distintas zonas de Cancún con
                            horarios flexibles y enfoque profesional basado en
                            evidencia.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto max-w-7xl px-6">
                <h2 class="mb-10">¿Cómo es nuestro proceso de atención?</h2>

                <div class="relative">
                    <div
                        class="pointer-events-none absolute left-8 right-8 top-8 hidden h-px bg-linear-to-r from-secondary/0 via-secondary/25 to-secondary/0 lg:block"
                    >
                    </div>

                    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                        <article
                            class="relative rounded-2xl border border-secondary/12 bg-white p-6 shadow-[0_16px_40px_rgba(0,45,94,0.08)]"
                        >
                            <p
                                class="mb-2 text-sm font-black uppercase tracking-[0.2em] text-primary-container"
                            >
                                01
                            </p>
                            <h3 class="mb-3 text-xl!">Valoración inicial</h3>
                            <p class="text-on-surface-variant">
                                Analizamos tu condición, dolor, movilidad y
                                objetivos.
                            </p>
                        </article>

                        <article
                            class="relative rounded-2xl border border-secondary/12 bg-white p-6 shadow-[0_16px_40px_rgba(0,45,94,0.08)]"
                        >
                            <p
                                class="mb-2 text-sm font-black uppercase tracking-[0.2em] text-primary-container"
                            >
                                02
                            </p>
                            <h3 class="mb-3 text-xl!">Plan terapéutico</h3>
                            <p class="text-on-surface-variant">
                                Definimos frecuencia, técnicas y metas medibles
                                para tu caso.
                            </p>
                        </article>

                        <article
                            class="relative rounded-2xl border border-secondary/12 bg-white p-6 shadow-[0_16px_40px_rgba(0,45,94,0.08)]"
                        >
                            <p
                                class="mb-2 text-sm font-black uppercase tracking-[0.2em] text-primary-container"
                            >
                                03
                            </p>
                            <h3 class="mb-3 text-xl!">Sesiones en casa</h3>
                            <p class="text-on-surface-variant">
                                Aplicamos terapia manual y ejercicio funcional
                                en tu entorno.
                            </p>
                        </article>

                        <article
                            class="relative rounded-2xl border border-secondary/12 bg-white p-6 shadow-[0_16px_40px_rgba(0,45,94,0.08)]"
                        >
                            <p
                                class="mb-2 text-sm font-black uppercase tracking-[0.2em] text-primary-container"
                            >
                                04
                            </p>
                            <h3 class="mb-3 text-xl!">Seguimiento y ajuste</h3>
                            <p class="text-on-surface-variant">
                                Medimos progreso y optimizamos el tratamiento
                                según tu evolución.
                            </p>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-surface-container-low py-20">
            <div class="mx-auto mb-10 max-w-7xl px-6 text-center">
                <h2>Servicios que puedes recibir a domicilio</h2>
                <p class="mt-3 text-lg text-on-surface-variant">
                    Conoce los tratamientos disponibles para acompañar tu
                    recuperación.
                </p>
            </div>
            <ServicesCarousel />
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto max-w-7xl px-6">
                <div
                    class="rounded-2xl bg-primary/30 p-10 text-center shadow-sm"
                >
                    <h2 class="mb-4">
                        Da el primer paso hacia tu recuperación
                    </h2>
                    <p
                        class="mx-auto mb-8 max-w-3xl text-lg text-on-surface-variant"
                    >
                        Si quieres saber si la rehabilitación física a domicilio
                        es adecuada para ti, escríbenos por WhatsApp y recibe
                        orientación personalizada.
                    </p>
                    <a
                        href={whatsappUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex rounded-lg bg-[#25d366] px-8 py-4 text-lg font-bold text-white transition-colors hover:bg-[#1ebe57]"
                    >
                        Solicitar información por WhatsApp
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <style>
        .homecare-main {
            background:
                radial-gradient(
                    circle at 10% 12%,
                    rgba(228, 206, 131, 0.18),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 92% 24%,
                    rgba(30, 95, 171, 0.12),
                    transparent 30%
                ),
                linear-gradient(180deg, #f7f8fb 0%, #f5f5f5 24%, #f5f5f5 100%);
        }
    </style>
</BaseLayout>
