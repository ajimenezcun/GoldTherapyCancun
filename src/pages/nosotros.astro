---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";

const whatsappUrl =
    "https://wa.me/529982701550?text=Hola%2C%20quiero%20agendar%20una%20cita";

const values = [
    {
        title: "Evaluación inicial detallada",
        description:
            "Revisamos historial, movilidad y origen del dolor antes de proponer un plan.",
    },
    {
        title: "Seguimiento por objetivos funcionales",
        description:
            "Ajustamos cada sesión según tu evolución real, no un protocolo genérico.",
    },
    {
        title: "Atención personalizada",
        description:
            "Trabajamos 1:1 contigo, sin lotes de pacientes ni prisas entre sesiones.",
    },
    {
        title: "Mismo terapeuta, siempre",
        description:
            "Gold Therapy opera con un solo terapeuta para mantener cercanía y consistencia.",
    },
];

const studies = [
    {
        title: "Licenciatura en Fisioterapia",
        institution: "Universidad de Ciencias de la Salud",
        year: "2016",
        description:
            "Formación clínica integral en evaluación funcional, terapia manual y rehabilitación musculoesquelética.",
    },
    {
        title: "Certificación en Rehabilitación Postoperatoria",
        institution: "Colegio Mexicano de Fisioterapia",
        year: "2019",
        description:
            "Protocolos de recuperación segura para pacientes ortopédicos y funcionales en fases tempranas y avanzadas.",
    },
    {
        title: "Diplomado en Fisioterapia Deportiva",
        institution: "Instituto de Ciencias del Deporte",
        year: "2021",
        description:
            "Prevención de lesiones, readaptación al entrenamiento y estrategias de retorno progresivo al deporte.",
    },
    {
        title: "Actualización en Neurorehabilitación",
        institution: "Asociación Latinoamericana de Rehabilitación",
        year: "2024",
        description:
            "Intervenciones terapéuticas para mejorar equilibrio, coordinación y autonomía en pacientes neurológicos.",
    },
];

const services = [
    {
        image: "/service-1.jpg",
        title: "Fisioterapia General",
        description:
            "Evaluación y tratamiento de molestias musculares y articulares del día a día, desde dolor de espalda hasta contracturas y lesiones leves. Diseñamos un plan a tu medida para que recuperes movilidad sin dolor y previengas recaídas a futuro.",
    },
    {
        image: "/service-2.jpg",
        title: "Rehabilitación Postoperatoria",
        description:
            "Recuperación guiada tras cirugías ortopédicas, traumatológicas o articulares, con protocolos personalizados por etapa. Acompañamos cada avance de cerca, ajustando el tratamiento conforme tu cuerpo va sanando.",
    },
    {
        image: "/service-3.jpg",
        title: "Fisioterapia Deportiva",
        description:
            "Prevención y tratamiento de lesiones para deportistas de todos los niveles, con enfoque en fuerza, movilidad y prevención de recaídas. Te ayudamos a volver a tu actividad física con confianza y sin miedo a lesionarte de nuevo.",
    },
    {
        image: "/service-4.jpg",
        title: "Fisioterapia Neurológica",
        description:
            "Terapia especializada para condiciones que afectan el sistema nervioso, como secuelas de EVC, esclerosis múltiple o lesiones medulares. Trabajamos en la recuperación funcional con ejercicios adaptados a cada caso.",
    },
    {
        image: "/service-5.jpg",
        title: "Rehabilitación Física",
        description:
            "Recuperación de movilidad, fuerza y funcionalidad a tu propio ritmo, ideal para procesos de larga duración o condiciones crónicas. Combinamos técnica manual y ejercicio terapéutico para resultados sostenibles.",
    },
];
---

<BaseLayout
    title="Nosotros | Gold Therapy Cancún"
    description="Conoce a Gold Therapy: formación, certificaciones y enfoque de atención de nuestra terapia física en Cancún."
>
    <Header />

    <main class="overflow-hidden">
        <!-- Hero -->
        <section class="py-20">
            <div class="container-page relative z-10">
                <h1 class="block text-center">
                    Conoce a <span class="text-primary">Gold Therapy</span>
                </h1>
                <p
                    class="mt-5 text-center mx-auto max-w-2/3 text-lg leading-relaxed md:text-xl"
                >
                    <span class="text-primary font-bold italic"
                        >Gold Therapy</span
                    >, es un espacio de <b>Fisioterapia en Cancún</b> dedicado a ayudarte
                    a recuperar movilidad, reducir el dolor y mejorar tu calidad de
                    vida con atención personalizada.
                </p>

                <div>
                    <video
                        autoplay
                        muted
                        loop
                        playsinline
                        class="mt-10 w-full rounded-lg"
                    >
                        <source src="/nosotros.mp4" type="video/mp4" />
                        Tu navegador no soporta la reproducción de videos.
                    </video>
                </div>
            </div>
        </section>

        <!-- Quiénes somos -->
        <section class="section-y bg-white">
            <div
                class="container-page grid gap-16 lg:grid-cols-[1fr_2fr] lg:items-center"
            >
                <div class="relative">
                    <div class="aspect-3/4 overflow-hidden rounded-lg">
                        <img
                            src="/the-doctor.webp"
                            alt="Mariana, terapeuta de Gold Therapy"
                            class="h-full w-full object-cover"
                        />
                    </div>
                </div>

                <div>
                    <h2 data-reveal class="mt-3 text-[32px]">
                        ¿Quiénes somos?
                    </h2>
                    <p
                        class="mt-5 text-lg leading-relaxed text-on-surface-variant"
                    >
                        Trabajamos de manera individual con cada paciente para
                        diseñar procesos de recuperación realistas y medibles.
                        Nuestro enfoque combina precisión clínica, empatía y
                        seguimiento continuo para que cada sesión tenga un
                        objetivo claro.
                    </p>
                    <p
                        class="mt-4 text-lg leading-relaxed text-on-surface-variant"
                    >
                        Actualmente, Gold Therapy opera con un solo terapeuta
                        para mantener un estándar alto de calidad, cercanía y
                        consistencia en cada tratamiento a domicilio.
                    </p>

                    <div class="mt-10 grid gap-8 sm:grid-cols-2">
                        {
                            values.map((value) => (
                                <div class="flex gap-3">
                                    <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-secondary" />
                                    <div>
                                        <p class="font-bold">{value.title}</p>
                                        <p class="mt-1 text-on-surface-variant">
                                            {value.description}
                                        </p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Estudios y certificaciones -->
        <section class="section-y bg-surface-container-low">
            <div class="container-page">
                <h2 data-reveal class="text-center text-[32px]">
                    Estudios y certificaciones
                </h2>
                <p
                    class="mx-auto mt-4 max-w-160 text-center text-lg leading-relaxed text-on-surface-variant"
                >
                    Formación académica y educación continua orientada a ofrecer
                    atención basada en evidencia y resultados funcionales.
                </p>

                <div class="mt-14 grid gap-6 md:grid-cols-2">
                    {
                        studies.map((study) => (
                            <article class="card p-7">
                                <p class="mb-2 text-sm font-bold uppercase tracking-wide text-primary-container">
                                    {study.year}
                                </p>
                                <h3 class="mb-3 text-xl!">{study.title}</h3>
                                <p class="mb-3 font-semibold text-secondary">
                                    {study.institution}
                                </p>
                                <p class="text-on-surface-variant">
                                    {study.description}
                                </p>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduceMotion) {
        // Los títulos de cada sección se revelan al entrar en pantalla,
        // igual que en el homepage, para marcar la jerarquía de contenido
        // conforme se hace scroll.
        gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((heading) => {
            gsap.from(heading, {
                opacity: 0,
                y: 24,
                duration: 0.7,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: heading,
                    start: "top 85%",
                },
            });
        });
    }
</script>
