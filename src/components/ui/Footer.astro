---
interface Props {
    variant?: "default" | "home";
}

const { variant = "default" } = Astro.props;
void variant;

const currentYear = new Date().getFullYear();
---

<footer
    class="w-full bg-[linear-gradient(165deg,#1E5FAB_0%,#003366_100%)] py-7"
>
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-8 md:grid-cols-4">
        <!-- Columna 1: Logo + descripción -->
        <div class="col-span-1">
            <div class="flex gap-5 flex-col items-center">
                <a href="/">
                    <img
                        src="/GoldTherapy.webp"
                        alt="Gold Therapy"
                        class="w-1/3 mx-auto md:w-2/5"
                    />
                </a>
                <p class="mb-8 text-base text-center text-white/70 md:text-sm">
                    Consultorio de terapia física en Cancún, dedicado a tu
                    rehabilitación y bienestar.
                </p>
            </div>
            <ul class="flex gap-5 justify-center">
                <li>
                    <a
                        href="#"
                        title="Facebook"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-white/60 transition-colors hover:text-white"
                        data-social="facebook"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="24"
                            height="24"
                            ><path
                                fill="#cda448"
                                d="M12 2.04c-5.5 0-10 4.49-10 10.02c0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89c1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02"
                            ></path></svg
                        >
                    </a>
                </li>
                <li>
                    <a
                        href="#"
                        title="Instagram"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-white/60 transition-colors hover:text-white"
                        data-social="instagram"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="24"
                            height="24"
                            ><path
                                fill="#cda448"
                                d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"
                            ></path></svg
                        >
                    </a>
                </li>
            </ul>
        </div>

        <!-- Columna 2: Servicios -->
        <div>
            <h4 class="mb-5 font-bold uppercase !text-primary">Servicios</h4>
            <ul
                class="space-y-3 *:text-white/60 *:transition-colors *:hover:text-white"
            >
                <li>
                    <a href="/servicios/fisioterapia-general"
                        >Fisioterapia General</a
                    >
                </li>
                <li>
                    <a href="/servicios/rehabilitacion-post-operatoria"
                        >Rehabilitación Post Operatoria</a
                    >
                </li>
                <li>
                    <a href="/servicios/fisioterapia-deportiva"
                        >Fisioterapia Deportiva</a
                    >
                </li>
                <li>
                    <a href="/servicios/fisioterapia-neurologica"
                        >Fisioterapia Neurológica</a
                    >
                </li>
            </ul>
        </div>

        <!-- Columna 3: Navegación -->
        <div>
            <h4 class="mb-5 font-bold uppercase !text-primary">Navegación</h4>
            <ul
                class="space-y-3 *:text-white/60 *:transition-colors *:hover:text-white"
            >
                <li><a href="/">Inicio</a></li>
                <li><a href="/sobre-mi">Sobre Mí</a></li>
                <li><a href="/servicios">Servicios</a></li>
                <li>
                    <a href="/preguntas-frecuentes">Preguntas Frecuentes</a>
                </li>
                <li><a href="/contacto">Contacto</a></li>
                <li>
                    <a href="/politicas-privacidad">Política de Privacidad</a>
                </li>
            </ul>
        </div>

        <!-- Columna 4: Contacto + Legal -->
        <div>
            <h4 class="mb-5 font-bold uppercase !text-primary">Contacto</h4>
            <ul class="mb-6 space-y-3 text-white/60">
                <li>
                    <a
                        class="transition-colors hover:text-white"
                        href="tel:+529982701550">+52 998 270 1550</a
                    >
                </li>
                <li>
                    <a
                        class="transition-colors hover:text-white"
                        href="mailto:info@goldtherapy.com"
                        >info@goldtherapy.com</a
                    >
                </li>
            </ul>
            <div>
                <h4 class="mb-5 font-bold uppercase !text-primary">ATENCIÓN</h4>
                <ul class="text-white/60 bg-white/15 p-3 rounded-md *:py-2">
                    <li class="border-b border-white/15">
                        Lunes-Viernes: 9:00AM / 5:00PM
                    </li>
                    <li>Sábado: 10:00AM / 2:00PM</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Barra inferior -->
    <div
        class="mx-auto mt-10 flex max-w-7xl flex-col items-center gap-6 border-t border-white/15 px-8 pt-8 md:flex-row md:justify-between"
    >
        <p class="text-xs text-white/50">
            © {currentYear} Gold Therapy Cancun. Todos los derechos reservados.
        </p>
        <p class="text-xs text-white/50">
            Desarrollado por <a
                href="https://creativoapp.com"
                title="Creativo APP | Ecommerce & Software Studio"
                class="font-semibold text-primary transition-colors hover:text-white"
                target="_blank">Creativo APP</a
            >
        </p>
    </div>
</footer>
