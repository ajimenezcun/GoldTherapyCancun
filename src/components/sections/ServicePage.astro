---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../ui/Header.astro";
import Footer from "../ui/Footer.astro";
import ServicesCarousel from "./ServicesCarousel.astro";

interface ServiceHighlight {
    title: string;
    description: string;
}

interface Props {
    serviceId: string;
    pageTitle: string;
    metaDescription: string;
    shortDescription: string;
    aboutIntro: string;
    serviceDetails: string[];
    forYouPoints: string[];
    highlights: ServiceHighlight[];
    heroImage: string;
}

const {
    serviceId,
    pageTitle,
    metaDescription,
    shortDescription,
    aboutIntro,
    serviceDetails,
    forYouPoints,
    highlights,
    heroImage,
}: Props = Astro.props;

const whatsappUrl = "https://wa.me/525500000000";
---

<BaseLayout title={`${pageTitle} | Gold Therapy`} description={metaDescription}>
    <Header />

    <main class="service-main overflow-hidden">
        <section class="relative overflow-hidden py-24 text-white">
            <img
                src={heroImage}
                alt={pageTitle}
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(112deg,rgba(0,27,55,0.9)_6%,rgba(0,51,102,0.72)_54%,rgba(0,51,102,0.26)_100%)]"
            >
            </div>
            <div
                class="absolute -left-24 top-16 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
            >
            </div>

            <div class="relative z-10 mx-auto max-w-7xl px-6">
                <div
                    class="mb-5 flex flex-wrap items-center gap-2 text-sm font-semibold text-white/90"
                >
                    <a href="/" class="transition-colors hover:text-primary"
                        >Inicio</a
                    >
                    <span aria-hidden="true">/</span>
                    <a
                        href="/servicios"
                        class="transition-colors hover:text-primary"
                        >Servicios</a
                    >
                    <span aria-hidden="true">/</span>
                    <span class="text-primary">{pageTitle}</span>
                </div>

                <h1 class="max-w-4xl text-white!">{pageTitle}</h1>
                <p
                    class="mt-5 max-w-3xl text-lg leading-relaxed text-white/90 md:text-xl"
                >
                    {shortDescription}
                </p>
            </div>
        </section>

        <section class="bg-white py-20">
            <div
                class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[1.3fr_0.8fr]"
            >
                <article class="space-y-8">
                    <div class="space-y-4">
                        <p
                            class="text-sm font-black uppercase tracking-[0.2em] text-primary-container"
                        >
                            Enfoque terapeutico
                        </p>
                        <h2>¿En qué consiste este servicio?</h2>
                        <p
                            class="text-lg leading-relaxed text-on-surface-variant"
                        >
                            {aboutIntro}
                        </p>
                    </div>

                    <div
                        class="rounded-2xl border border-secondary/12 bg-surface p-7"
                    >
                        <h3 class="text-2xl!">¿Qué trabajamos en sesión?</h3>
                        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                            {
                                serviceDetails.map((detail) => (
                                    <li class="service-detail-item rounded-xl border border-secondary/10 bg-white px-4 py-3 text-on-surface-variant">
                                        {detail}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </article>

                <article
                    class="rounded-2xl border border-secondary/10 bg-surface-container-low p-7 lg:mt-12"
                >
                    <h3 class="text-2xl!">¿Cuándo este servicio es para mí?</h3>
                    <ul class="mt-5 space-y-4">
                        {
                            forYouPoints.map((point) => (
                                <li class="flex items-start gap-3">
                                    <span
                                        class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
                                        aria-hidden="true"
                                    />
                                    <span class="text-on-surface-variant">
                                        {point}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            </div>
        </section>

        <section class="bg-white py-10">
            <div class="mx-auto max-w-7xl px-6">
                <div class="mb-10 max-w-3xl">
                    <h2>Beneficios de {pageTitle} en Cancun</h2>
                    <p class="mt-3 text-lg text-on-surface-variant">
                        Resultados esperados y ventajas clinicas del tratamiento
                        para avanzar de forma segura y sostenible.
                    </p>
                </div>

                <div class="relative">
                    <div
                        class="pointer-events-none absolute left-8 right-8 top-8 hidden h-px bg-linear-to-r from-secondary/0 via-secondary/25 to-secondary/0 lg:block"
                    >
                    </div>

                    <div class="grid gap-6 lg:grid-cols-3">
                        {
                            highlights.map((highlight, index) => (
                                <article class="relative rounded-2xl border border-secondary/12 bg-white p-6 shadow-[0_16px_40px_rgba(0,45,94,0.08)]">
                                    <p class="text-sm font-black tracking-[0.2em] text-primary-container">
                                        0{index + 1}
                                    </p>
                                    <h3 class="mt-3 text-2xl!">
                                        {highlight.title}
                                    </h3>
                                    <p class="mt-3 text-on-surface-variant">
                                        {highlight.description}
                                    </p>
                                </article>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto mb-10 max-w-7xl px-6 text-center">
                <h2>Conoce otros servicios</h2>
                <p class="mt-3 text-lg text-on-surface-variant">
                    Explora tratamientos relacionados para complementar tu
                    recuperación.
                </p>
            </div>
            <ServicesCarousel excludeId={serviceId} />
        </section>

        <section class="bg-white py-20">
            <div class="mx-auto max-w-7xl px-6">
                <div
                    class="rounded-2xl bg-primary/30 p-10 text-center shadow-sm"
                >
                    <h2 class="mb-4">
                        ¿Necesitas más información sobre este servicio?
                    </h2>
                    <p
                        class="mx-auto mb-8 max-w-3xl text-lg text-on-surface-variant"
                    >
                        Escríbenos por WhatsApp y te ayudamos a evaluar tu caso
                        para iniciar tu tratamiento de forma segura y
                        personalizada.
                    </p>
                    <a
                        href={whatsappUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex rounded-lg bg-[#25d366] px-8 py-4 text-lg font-bold text-white transition-colors hover:bg-[#1ebe57]"
                    >
                        Solicitar información por WhatsApp
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <style>
        .service-main {
            background:
                radial-gradient(
                    circle at 10% 12%,
                    rgba(228, 206, 131, 0.18),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 92% 24%,
                    rgba(30, 95, 171, 0.12),
                    transparent 30%
                ),
                linear-gradient(180deg, #f7f8fb 0%, #f5f5f5 24%, #f5f5f5 100%);
        }

        .service-detail-item {
            position: relative;
            padding-left: 2.2rem;
            font-weight: 600;
        }

        .service-detail-item::before {
            content: "";
            position: absolute;
            left: 0.95rem;
            top: 1.05rem;
            width: 0.8rem;
            height: 0.8rem;
            border-radius: 999px;
            background: linear-gradient(135deg, #e4ce83 0%, #d8b95c 100%);
            box-shadow: 0 0 0 4px rgba(228, 206, 131, 0.24);
        }
    </style>
</BaseLayout>
