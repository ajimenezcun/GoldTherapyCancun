---
interface Props {
    variant?: "default" | "home";
}

const { variant = "default" } = Astro.props;

const isHome = variant === "home";

const headerClass = isHome
    ? "absolute inset-x-0 top-0 z-50 w-full px-3 pt-3 md:px-6 md:pt-4 transition-all duration-500"
    : "sticky top-0 w-full z-50 bg-white/80 backdrop-blur-xl shadow-[0_10px_40px_rgba(0,30,64,0.06)]";

const innerClass = isHome
    ? "flex justify-between items-center w-full px-6 lg:px-8 py-3 max-w-7xl mx-auto rounded-2xl border border-white/55 bg-[linear-gradient(180deg,rgba(255,255,255,0.95)_0%,rgba(255,255,255,0.88)_100%)] shadow-[0_16px_35px_rgba(0,35,89,0.15)] backdrop-blur-xl"
    : "flex justify-between items-center w-full px-6 lg:px-8 py-3 max-w-7xl mx-auto";

const navClass = isHome
    ? "hidden md:flex items-center space-x-7 *:uppercase *:font-serif *:text-sm"
    : "hidden md:flex items-center space-x-7 *:uppercase *:font-serif *:text-sm";
---

<header class={headerClass} data-mobile-header>
    <div class={innerClass} data-home-shell={isHome ? "true" : undefined}>
        <div class="text-xl font-bold tracking-tight text-primary-container">
            <a href="/"
                ><img
                    src="/GoldTherapy.webp"
                    alt="Gold Therapy"
                    class="w-20"
                /></a
            >
        </div>

        <nav class={navClass}>
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/sobre-mi">Sobre Mi</a
            >
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/servicios">Servicios</a
            >
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/a-domicilio">a Domicilio</a
            >
            <a
                class="text-black/80 font-semibold tracking-wide hover:text-secondary transition-colors"
                href="/contacto">Contacto</a
            >
        </nav>

        <div class="flex items-center space-x-6">
            <a
                class="hidden lg:block font-bold text-primary-strong text-lg"
                href="tel:+525500000000"
            >
                +52 998 270 1550
            </a>
            <a
                href="https://wa.me/525500000000"
                class="hidden lg:flex items-center gap-2 rounded-full bg-secondary text-white px-5 py-2.5 font-bold shadow-[0_10px_24px_rgba(0,62,133,0.35)] hover:bg-primary-container transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 16 16"
                    ><path
                        fill="#ffffff"
                        d="M13.95 4.24C11.86 1 7.58.04 4.27 2.05C1.04 4.06 0 8.44 2.09 11.67l.17.26l-.7 2.62l2.62-.7l.26.17c1.13.61 2.36.96 3.58.96c1.31 0 2.62-.35 3.75-1.05c3.23-2.1 4.19-6.39 2.18-9.71Zm-1.83 6.74c-.35.52-.79.87-1.4.96c-.35 0-.79.17-2.53-.52c-1.48-.7-2.71-1.84-3.58-3.15c-.52-.61-.79-1.4-.87-2.19c0-.7.26-1.31.7-1.75c.17-.17.35-.26.52-.26h.44c.17 0 .35 0 .44.35c.17.44.61 1.49.61 1.58c.09.09.05.76-.35 1.14c-.22.25-.26.26-.17.44c.35.52.79 1.05 1.22 1.49c.52.44 1.05.79 1.66 1.05c.17.09.35.09.44-.09c.09-.17.52-.61.7-.79c.17-.17.26-.17.44-.09l1.4.7c.17.09.35.17.44.26c.09.26.09.61-.09.87Z"
                    ></path></svg
                >
                AGENDAR
            </a>
            <button
                type="button"
                class="md:hidden rounded-md p-1.5 transition-colors hover:bg-primary/20"
                aria-label="Abrir menu"
                aria-controls="mobile-menu-drawer"
                aria-expanded="false"
                data-mobile-menu-trigger
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        fill="#E4CE83"
                        fill-rule="evenodd"
                        d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75M3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12m8.25 5.25a.75.75 0 0 1 .75-.75h8.25a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75"
                        clip-rule="evenodd"
                    ></path>
                </svg>
            </button>
        </div>
    </div>

    <div
        class="mobile-menu-overlay fixed inset-0 z-60 bg-secondary/50 md:hidden"
        data-mobile-overlay
        aria-hidden="true"
    ></div>

    <aside
        id="mobile-menu-drawer"
        class="mobile-menu-drawer fixed left-0 top-0 z-70 h-screen w-[75vw] max-w-sm border-r border-secondary/10 bg-white md:hidden"
        aria-hidden="true"
        data-mobile-drawer
    >
        <div class="flex h-full flex-col">
            <div class="flex items-center justify-between border-b border-secondary/10 px-5 py-4">
                <a href="/" class="inline-flex" data-mobile-menu-link>
                    <img src="/GoldTherapy.webp" alt="Gold Therapy" class="w-16" />
                </a>
                <button
                    type="button"
                    class="rounded-md p-2 text-secondary transition-colors hover:bg-secondary/10"
                    aria-label="Cerrar menu"
                    data-mobile-menu-close
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            fill="currentColor"
                            d="m12 10.586l4.95-4.95l1.414 1.414L13.414 12l4.95 4.95l-1.414 1.414L12 13.414l-4.95 4.95l-1.414-1.414l4.95-4.95l-4.95-4.95l1.414-1.414z"
                        ></path>
                    </svg>
                </button>
            </div>

            <nav class="flex flex-1 flex-col px-5 py-5">
                <a
                    href="/sobre-mi"
                    class="mobile-menu-link"
                    data-mobile-menu-link
                >Sobre Mi</a>
                <a
                    href="/servicios"
                    class="mobile-menu-link"
                    data-mobile-menu-link
                >Servicios</a>
                <a
                    href="/a-domicilio"
                    class="mobile-menu-link"
                    data-mobile-menu-link
                >a Domicilio</a>
                <a
                    href="/contacto"
                    class="mobile-menu-link"
                    data-mobile-menu-link
                >Contacto</a>
            </nav>

            <div class="border-t border-secondary/10 px-5 py-5">
                <a
                    href="https://wa.me/525500000000"
                    class="inline-flex w-full items-center justify-center rounded-xl bg-secondary px-5 py-3 font-bold text-white"
                    data-mobile-menu-link
                >
                    AGENDAR
                </a>
            </div>
        </div>
    </aside>
</header>

{
    isHome &&
        <script>
            const homeHeader = document.querySelector("header[data-mobile-header]");

            const toggleHeaderScrollState = () => {
                if (!homeHeader) return;

                if (window.scrollY > 24) {
                    homeHeader.setAttribute("data-scrolled", "true");
                } else {
                    homeHeader.removeAttribute("data-scrolled");
                }
            };

            toggleHeaderScrollState();
            window.addEventListener("scroll", toggleHeaderScrollState, {
                passive: true,
            });
        </script>
}

<script>
    const mobileHeader = document.querySelector("[data-mobile-header]");

    if (mobileHeader) {
        const menuTrigger = mobileHeader.querySelector("[data-mobile-menu-trigger]");
        const menuClose = mobileHeader.querySelector("[data-mobile-menu-close]");
        const menuOverlay = mobileHeader.querySelector("[data-mobile-overlay]");
        const menuDrawer = mobileHeader.querySelector("[data-mobile-drawer]");
        const menuLinks = mobileHeader.querySelectorAll("[data-mobile-menu-link]");

        const isMenuOpen = () =>
            mobileHeader.getAttribute("data-mobile-open") === "true";

        const openMenu = () => {
            mobileHeader.setAttribute("data-mobile-open", "true");
            document.body.style.overflow = "hidden";

            if (menuTrigger) {
                menuTrigger.setAttribute("aria-expanded", "true");
            }

            if (menuDrawer) {
                menuDrawer.setAttribute("aria-hidden", "false");
            }
        };

        const closeMenu = () => {
            mobileHeader.setAttribute("data-mobile-open", "false");
            document.body.style.overflow = "";

            if (menuTrigger) {
                menuTrigger.setAttribute("aria-expanded", "false");
            }

            if (menuDrawer) {
                menuDrawer.setAttribute("aria-hidden", "true");
            }
        };

        closeMenu();

        if (menuTrigger) {
            menuTrigger.addEventListener("click", () => {
                openMenu();
            });
        }

        if (menuClose) {
            menuClose.addEventListener("click", () => {
                closeMenu();
            });
        }

        if (menuOverlay) {
            menuOverlay.addEventListener("click", () => {
                closeMenu();
            });
        }

        document.addEventListener("pointerdown", (event) => {
            if (!isMenuOpen()) return;

            const target = event.target as Node | null;
            if (!target) return;

            const clickedInsideDrawer = menuDrawer?.contains(target);
            const clickedTrigger = menuTrigger?.contains(target);

            if (!clickedInsideDrawer && !clickedTrigger) {
                closeMenu();
            }
        });

        menuLinks.forEach((link) => {
            link.addEventListener("click", () => {
                closeMenu();
            });
        });

        window.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeMenu();
            }
        });
    }
</script>

<style>
    header[data-scrolled="true"] {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding-top: 0.6rem;
    }

    header[data-scrolled="true"] [data-home-shell="true"] {
        border-color: rgba(255, 255, 255, 0.75);
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.97) 0%,
            rgba(255, 255, 255, 0.92) 100%
        );
        box-shadow: 0 14px 34px rgba(0, 35, 89, 0.18);
    }

    header:not([data-scrolled="true"]) [data-home-shell="true"] {
        border-color: rgba(255, 255, 255, 0.5);
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.88) 0%,
            rgba(255, 255, 255, 0.78) 100%
        );
    }

    .mobile-menu-overlay {
        opacity: 0;
        pointer-events: none;
        transition: opacity 220ms ease;
    }

    .mobile-menu-drawer {
        transform: translateX(-100%);
        opacity: 0.92;
        transition: transform 220ms ease, opacity 220ms ease;
    }

    [data-mobile-header][data-mobile-open="true"] .mobile-menu-overlay {
        opacity: 1;
        pointer-events: auto;
    }

    [data-mobile-header][data-mobile-open="true"] .mobile-menu-drawer {
        transform: translateX(0);
        opacity: 1;
    }

    .mobile-menu-link {
        border-bottom: 1px solid rgba(30, 95, 171, 0.12);
        padding: 0.95rem 0;
        font-family: var(--font-serif);
        font-size: 1.02rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #1e5fab;
        transition: color 180ms ease;
    }

    .mobile-menu-link:hover {
        color: #c9a943;
    }
</style>
